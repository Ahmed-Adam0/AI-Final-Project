      "parameters": {
        "jsCode": "const searchTerm = typeof query !== 'undefined' ? encodeURIComponent(query) : '';\nconst min = typeof minPrice !== 'undefined' ? encodeURIComponent(minPrice) : '';\nconst max = typeof maxPrice !== 'undefined' ? encodeURIComponent(maxPrice) : '';\nconst cat = typeof categoryId !== 'undefined' ? encodeURIComponent(categoryId) : '';\nconst mat = typeof material !== 'undefined' ? encodeURIComponent(material) : '';\nconst shop = typeof workshopId !== 'undefined' ? encodeURIComponent(workshopId) : '';\n\nconst response = await this.helpers.httpRequest({\n  method: 'GET',\n  url: `http://home-ai.runasp.net/api/Products?search=${searchTerm}&categoryId=${cat}&minPrice=${min}&maxPrice=${max}&material=${mat}&workshopId=${shop}&pageNumber=1&pageSize=5`,\n  headers: { 'Content-Type': 'application/json' },\n  returnFullResponse: false,\n});\nconst productsData = response.data || response;\nif (Array.isArray(productsData)) {\n  return JSON.stringify(productsData.map(p => ({ id: p.id, name: p.name, price: p.price, desc: p.description ? p.description.substring(0, 30) + '...' : '' })));\n}\nreturn JSON.stringify(productsData);"
