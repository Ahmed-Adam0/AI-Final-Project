@model AdminFaqPageViewModel
@using Graduation_Application.IServices.Admin
@inject Graduation_Application.IServices.Admin.ILocalizationService L
@{
    ViewData["Title"] = L.Get("admin.faq.index.title");
}

<div class="row align-items-center mb-4">
    <div class="col-md-6">
        <h1 class="display-font text-light mb-1">@L.Get("admin.faq.index.heading")</h1>
        <p class="text-muted mb-0">@L.Get("admin.faq.index.subheading")</p>
    </div>
    <div class="col-md-6 text-md-end mt-3 mt-md-0 d-flex justify-content-md-end align-items-center gap-3">
        <div class="glass-card px-3 py-2 d-inline-flex align-items-center gap-3">
            <span class="text-muted small">@L.Get("admin.faq.index.total"):</span>
            <span class="badge fs-6 font-monospace" style="background-color: var(--accent-primary);">@Model.Faqs.Count</span>
        </div>
        <a asp-area="Admin" asp-controller="Faq" asp-action="Create" class="btn btn-premium btn-premium-primary">
            <i class="fa-solid fa-plus me-1"></i> @L.Get("admin.faq.index.addButton")
        </a>
    </div>
</div>

<!-- Search Panel -->
<div class="glass-card p-4 mb-4">
    <h5 class="text-light mb-3"><i class="fa-solid fa-filter me-2" style="color: var(--accent-primary);"></i>@L.Get("admin.faq.index.filterTitle")</h5>
    <form method="get" asp-area="Admin" asp-controller="Faq" asp-action="Index">
        <div class="row g-3">
            <div class="col-md-8">
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0" style="border-color: var(--border-color); color: var(--text-muted);">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </span>
                    <input type="text" name="Search" class="form-control form-control-premium border-start-0 ps-0" placeholder="@L.Get("admin.faq.index.searchPlaceholder")" value="@Model.Search" />
                </div>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-premium btn-premium-primary flex-grow-1">
                    <i class="fa-solid fa-check"></i> @L.Get("admin.faq.index.searchButton")
                </button>
                <a asp-area="Admin" asp-controller="Faq" asp-action="Index" class="btn btn-premium btn-premium-secondary">
                    <i class="fa-solid fa-arrow-rotate-left"></i> @L.Get("admin.faq.index.resetButton")
                </a>
            </div>
        </div>
    </form>
</div>

<!-- FAQs Table -->
<div class="glass-card p-4">
    @if (Model.Faqs == null || !Model.Faqs.Any())
    {
        <div class="text-center py-5">
            <div class="text-muted mb-3"><i class="fa-solid fa-circle-question fa-3x"></i></div>
            <h5 class="text-light">@L.Get("admin.faq.index.emptyTitle")</h5>
            <p class="text-muted small">@L.Get("admin.faq.index.emptySubtitle")</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-premium">
                <thead>
                    <tr>
                        <th style="width: 30%;">@L.Get("admin.faq.table.questionEn")</th>
                        <th style="width: 30%;">@L.Get("admin.faq.table.questionAr")</th>
                        <th class="text-center" style="width: 10%;">@L.Get("admin.faq.table.order")</th>
                        <th class="text-center" style="width: 15%;">@L.Get("admin.faq.table.status")</th>
                        <th class="text-end" style="width: 15%;">@L.Get("admin.faq.table.actions")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Faqs)
                    {
                        <tr>
                            <!-- English Q&A -->
                            <td class="align-middle">
                                <div class="text-light font-weight-bold">@item.QuestionEn</div>
                                <div class="text-muted small text-truncate-custom mt-1" title="@item.AnswerEn">@item.AnswerEn</div>
                            </td>
                            <!-- Arabic Q&A -->
                            <td class="align-middle">
                                <div class="text-light font-weight-bold text-end" dir="rtl">@item.QuestionAr</div>
                                <div class="text-muted small text-truncate-custom text-end mt-1" dir="rtl" title="@item.AnswerAr">@item.AnswerAr</div>
                            </td>
                            <!-- Display Order -->
                            <td class="text-center align-middle font-monospace text-light">@item.DisplayOrder</td>
                            <!-- Status -->
                            <td class="text-center align-middle">
                                <div class="d-inline-flex align-items-center gap-2">
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">@L.Get("admin.faq.status.active")</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">@L.Get("admin.faq.status.inactive")</span>
                                    }
                                    
                                    <form asp-area="Admin" asp-controller="Faq" asp-action="UpdateStatus" asp-route-id="@item.Id" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="isActive" value="@((!item.IsActive).ToString().ToLower())" />
                                        <button type="submit" class="btn btn-sm btn-outline-light py-0 px-1 border-0" title="@L.Get("admin.faq.table.toggleStatus")">
                                            @if (item.IsActive)
                                            {
                                                <i class="fa-solid fa-toggle-on text-success fs-5"></i>
                                            }
                                            else
                                            {
                                                <i class="fa-solid fa-toggle-off text-muted fs-5"></i>
                                            }
                                        </button>
                                    </form>
                                </div>
                            </td>
                            <!-- Actions -->
                            <td class="text-end align-middle">
                                <div class="d-flex justify-content-end gap-2">
                                    <a asp-area="Admin" asp-controller="Faq" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-premium btn-premium-secondary py-1 px-2" title="@L.Get("admin.faq.table.editTitle")">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>
                                    
                                    <form asp-area="Admin" asp-controller="Faq" asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('@L.Get("admin.faq.table.deleteConfirm")');" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-premium btn-premium-danger py-1 px-2" title="@L.Get("admin.faq.table.deleteTitle")">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<style>
    .text-truncate-custom {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: normal;
        max-width: 300px;
    }
</style>
