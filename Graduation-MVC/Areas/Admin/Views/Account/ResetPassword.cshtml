@using Graduation_MVC.Areas.Admin.ViewModels.Auth
@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAuth.cshtml";
}

<div class="text-center mb-4">
    <div class="logo"><i class="fa-solid fa-key me-2"></i> Reset Password</div>
</div>

<form asp-action="ResetPassword" method="post" asp-area="Admin" asp-antiforgery="true">
    <input asp-for="Email" type="hidden" />
    <input asp-for="OtpCode" type="hidden" />

    <div class="mb-3">
        <p class="text-muted small mb-2">Password must contain:</p>
        <ul class="list-unstyled small" id="passwordRequirements">
            <li id="req-length">
                <i class="fa-solid fa-circle-xmark text-danger me-1"></i>
                <span>At least 8 characters</span>
            </li>
            <li id="req-upper">
                <i class="fa-solid fa-circle-xmark text-danger me-1"></i>
                <span>At least one uppercase letter</span>
            </li>
            <li id="req-lower">
                <i class="fa-solid fa-circle-xmark text-danger me-1"></i>
                <span>At least one lowercase letter</span>
            </li>
            <li id="req-digit">
                <i class="fa-solid fa-circle-xmark text-danger me-1"></i>
                <span>At least one digit</span>
            </li>
            <li id="req-special">
                <i class="fa-solid fa-circle-xmark text-danger me-1"></i>
                <span>At least one special character</span>
            </li>
        </ul>
    </div>

    <div class="mb-3">
        <div class="input-group">
            <span class="input-group-text"><i class="fa-solid fa-key"></i></span>
            <input asp-for="NewPassword" type="password" class="form-control form-control-premium" id="newPassword" />
            <button type="button" class="btn btn-outline-secondary" onclick="toggleNewPassword()"><i class="fa fa-eye"></i></button>
        </div>
        <span asp-validation-for="NewPassword" class="text-danger small d-block mt-1"></span>
    </div>

    <div class="mb-3">
        <div class="input-group">
            <span class="input-group-text"><i class="fa-solid fa-key"></i></span>
            <input asp-for="ConfirmPassword" type="password" class="form-control form-control-premium" />
        </div>
        <span asp-validation-for="ConfirmPassword" class="text-danger small d-block mt-1"></span>
    </div>

    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

    <button type="submit" class="btn btn-premium-primary w-100">Reset Password</button>

    <div class="mt-3 text-center">
        <a asp-action="Login">Back to Login</a>
    </div>
</form>

@section Scripts {
    <script>
        function toggleNewPassword() {
            var p = document.getElementById('newPassword');
            if (p.type === 'password') p.type = 'text'; else p.type = 'password';
        }

        document.getElementById('newPassword').addEventListener('input', function () {
            var val = this.value;

            function check(id, condition) {
                var el = document.getElementById(id);
                var icon = el.querySelector('i');
                if (condition) {
                    icon.className = 'fa-solid fa-circle-check text-success me-1';
                } else {
                    icon.className = 'fa-solid fa-circle-xmark text-danger me-1';
                }
            }

            check('req-length', val.length >= 8);
            check('req-upper', /[A-Z]/.test(val));
            check('req-lower', /[a-z]/.test(val));
            check('req-digit', /[0-9]/.test(val));
            check('req-special', /[^A-Za-z0-9]/.test(val));
        });
    </script>
}
