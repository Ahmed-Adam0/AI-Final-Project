@using Graduation_MVC.Areas.Admin.ViewModels.Auth
@using Graduation_Application.IServices.Admin
@inject ILocalizationService LocalizationService
@model LoginViewModel
@{
    ViewData["Title"] = LocalizationService.Get("auth.login.title");
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAuth.cshtml";
}

<h4 class="text-center mb-4">@LocalizationService.Get("auth.login.title")</h4>

<form asp-action="Login" method="post" class="mt-3">
    <div class="mb-3">
        <label class="form-label">@LocalizationService.Get("auth.login.email")</label>
        <div class="input-group">
            <span class="input-group-text"><i class="fa-solid fa-envelope"></i></span>
            <input asp-for="Email" class="form-control form-control-premium" placeholder="@LocalizationService.Get("auth.login.email")" />
        </div>
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    
    <div class="mb-3">
        <label class="form-label">@LocalizationService.Get("auth.login.password")</label>
        <div class="input-group">
            <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
            <input asp-for="Password" type="password" class="form-control form-control-premium" id="password" placeholder="@LocalizationService.Get("auth.login.password")" />
            <button type="button" class="btn btn-outline-secondary" onclick="togglePassword()"><i class="fa fa-eye"></i></button>
        </div>
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
    
    <div class="mb-3 form-check">
        <input asp-for="RememberMe" class="form-check-input" />
        <label class="form-check-label" asp-for="RememberMe">@LocalizationService.Get("auth.login.rememberMe")</label>
    </div>
    
    <button type="submit" class="btn btn-premium-primary w-100">@LocalizationService.Get("auth.login.submit")</button>

    <div class="mt-3 text-center">
        <a asp-action="ForgotPassword">@LocalizationService.Get("auth.login.forgotPassword")</a>
    </div>
</form>

@section Scripts {
    <script>
        function togglePassword() {
            var p = document.getElementById('password');
            if (p.type === 'password') p.type = 'text'; else p.type = 'password';
        }
    </script>

    @if (!string.IsNullOrEmpty(ViewBag.LanguageChanged))
    {
        <script>
            // Clear the flag after page load
            history.replaceState({}, document.title, window.location.pathname);
        </script>
    }
}

