@using Graduation_MVC.Areas.Admin.ViewModels.Auth
@using Graduation_Application.IServices.Admin
@inject ILocalizationService LocalizationService
@model ForgotPasswordViewModel
@{
    ViewData["Title"] = LocalizationService.Get("auth.forgotPassword.title");
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAuth.cshtml";
}

<h4 class="text-center mb-4">@LocalizationService.Get("auth.forgotPassword.title")</h4>

<form asp-action="ForgotPassword" method="post">
    <div class="mb-3">
        <div class="input-group">
            <span class="input-group-text"><i class="fa-solid fa-envelope"></i></span>
            <input asp-for="Email" class="form-control form-control-premium" placeholder="@LocalizationService.Get("auth.forgotPassword.email")" />
        </div>
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>
    <button type="submit" class="btn btn-premium-primary w-100">@LocalizationService.Get("auth.forgotPassword.submit")</button>

    <div class="mt-3 text-center">
        <a asp-action="Login">@LocalizationService.Get("auth.forgotPassword.backToLogin")</a>
    </div>
</form>
