@using Graduation_MVC.Areas.Admin.ViewModels.Auth
@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAuth.cshtml";
}

<div class="d-flex align-items-center justify-content-center vh-100">
    <div class="w-100" style="max-width:480px;">
        <div class="text-center mb-4">
            <div class="logo"><i class="fa-solid fa-lock-open me-2"></i> Forgot Password</div>
        </div>

        <form asp-action="ForgotPassword" method="post">
            <div class="mb-3">
                <div class="input-group">
                    <span class="input-group-text"><i class="fa-solid fa-envelope"></i></span>
                    <input asp-for="Email" class="form-control form-control-premium" />
                </div>
            </div>
            <button type="submit" class="btn btn-premium btn-premium-primary w-100">Send OTP</button>

            <div class="mt-3 text-center">
                <a asp-action="Login">Back to Login</a>
            </div>
        </form>
    </div>
</div>
