@using Graduation_MVC.Areas.Admin.ViewModels.Auth
@model VerifyOtpViewModel
@{
    ViewData["Title"] = "Verify OTP";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAuth.cshtml";
}

<div class="d-flex align-items-center justify-content-center vh-100">
    <div class="w-100" style="max-width:480px;">
        <div class="text-center mb-4">
            <div class="logo"><i class="fa-solid fa-shield-halved me-2"></i> Verify OTP</div>
        </div>

        <form asp-action="VerifyOtp" method="post">
            <input asp-for="Email" type="hidden" />

            <div class="mb-3 text-center">
                <input asp-for="OtpCode" class="form-control form-control-premium text-center" style="font-size:1.4rem;" />
            </div>

            <button type="submit" class="btn btn-premium btn-premium-primary w-100">Verify</button>

            <div class="mt-3 text-center">
                <a asp-action="ForgotPassword">Back</a>
            </div>
        </form>
    </div>
</div>
