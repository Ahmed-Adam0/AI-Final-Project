@model Graduation_MVC.Areas.Admin.ViewModels.Vendors.AdminVendorsPageViewModel

@{
    ViewData["Title"] = "Pending Vendors";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="mb-1">Pending Vendors</h2>
        <p class="text-muted mb-0">Review and approve or reject new vendor registrations.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-area="Admin" asp-controller="Vendors" asp-action="Index" class="btn btn-premium btn-premium-secondary">
            <i class="fa-solid fa-arrow-left"></i> All Vendors
        </a>
        <a asp-area="Admin" asp-controller="Vendors" asp-action="History" class="btn btn-premium btn-premium-secondary">
            <i class="fa-solid fa-timeline"></i> History
        </a>
    </div>
</div>

<partial name="_VendorsList" model="Model" />

