@model Graduation_MVC.Areas.Admin.ViewModels.Vendors.AdminVendorsPageViewModel
@using Graduation_Application.IServices.Admin
@inject ILocalizationService L

@{
    ViewData["Title"] = L.Get("auth.vendors.title");
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="mb-1">@L.Get("auth.vendors.title")</h2>
        <p class="text-muted mb-0">@L.Get("auth.vendors.subtitle")</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-area="Admin" asp-controller="Vendors" asp-action="Pending" class="btn btn-premium btn-premium-secondary">
            <i class="fa-solid fa-clock"></i> @L.Get("auth.vendors.pendingVendors")
        </a>
        <a asp-area="Admin" asp-controller="Vendors" asp-action="History" class="btn btn-premium btn-premium-secondary">
            <i class="fa-solid fa-timeline"></i> @L.Get("auth.vendors.history")
        </a>
    </div>
</div>

<partial name="_VendorsList" model="Model" />
