@model Graduation_MVC.Areas.Admin.ViewModels.Vendors.AdminVendorHistoryViewModel
@using Graduation_MVC.Areas.Admin.ViewModels.Shared
@using Graduation_Application.IServices.Admin
@inject ILocalizationService L

@{
    ViewData["Title"] = L.Get("auth.vendors.historyTitle");
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="mb-1">@L.Get("auth.vendors.historyTitle")</h2>
        <p class="text-muted mb-0">@L.Get("auth.vendors.historySubtitle")</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-area="Admin" asp-controller="Vendors" asp-action="Index" class="btn btn-premium btn-premium-secondary">
            <i class="fa-solid fa-arrow-left"></i> @L.Get("auth.vendors.backToVendors")
        </a>
    </div>
</div>

<div class="glass-card p-4">
    <div class="table-responsive">
        <table class="table table-premium align-middle mb-0">
            <thead>
                <tr>
                    <th>@L.Get("auth.vendors.colDate")</th>
                    <th>@L.Get("auth.vendors.colVendor")</th>
                    <th>@L.Get("auth.vendors.colAction")</th>
                    <th>@L.Get("auth.vendors.colAdmin")</th>
                    <th>@L.Get("auth.vendors.colDetails")</th>
                    <th class="text-end">@L.Get("auth.vendors.colOpen")</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="6" class="text-muted">@L.Get("auth.vendors.noHistory")</td></tr>
                }
                else
                {
                    foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="fw-semibold">@item.WorkshopName</td>
                            <td>
                                <span class="badge @item.BadgeClass">@item.Action</span>
                            </td>
                            <td>@(item.AdminName ?? "-")</td>
                            <td class="text-muted small">@item.Details</td>
                            <td class="text-end">
                                <a asp-area="Admin" asp-controller="Vendors" asp-action="Details" asp-route-id="@item.WorkshopId"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="fa-solid fa-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @{
        var pagination = new AdminPaginationViewModel
        {
            PageNumber = Model.Paging.Page,
            TotalPages = Model.Paging.TotalPages,
            TotalCount = Model.Paging.TotalCount,
            Controller = "Vendors",
            Action = "History",
            PageNumberParamName = "page",
            RouteValues = new { pageSize = Model.Paging.PageSize }
        };
    }
    <partial name="~/Areas/Admin/Views/Shared/_Pagination.cshtml" model="pagination" />
</div>
