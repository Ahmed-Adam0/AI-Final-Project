@model Graduation_MVC.Areas.Admin.ViewModels.Vendors.AdminVendorDetailsViewModel
@using Graduation_MVC.Areas.Admin.ViewModels.Shared
@using Graduation_Application.IServices.Admin
@inject ILocalizationService L

@{
    ViewData["Title"] = L.Get("auth.vendors.detailsTitle");
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="mb-1">@L.Get("auth.vendors.detailsTitle")</h2>
        <p class="text-muted mb-0">@L.Get("auth.vendors.detailsSubtitle")</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-area="Admin" asp-controller="Vendors" asp-action="Index" class="btn btn-premium btn-premium-secondary">
            <i class="fa-solid fa-arrow-left"></i> @L.Get("auth.vendors.back")
        </a>
        <a asp-area="Admin" asp-controller="Vendors" asp-action="History" class="btn btn-premium btn-premium-secondary">
            <i class="fa-solid fa-timeline"></i> @L.Get("auth.vendors.history")
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-4">
        <div class="glass-card p-4 h-100">
            <div class="d-flex align-items-center gap-3">
                <img src="@(string.IsNullOrWhiteSpace(Model.Profile.ProfileImage) ? "https://res.cloudinary.com/deko7oqij/image/upload/v1780328043/workshops/wlk9lyvdkppbd2jo23nn.png" : Model.Profile.ProfileImage)"
                     class="rounded-circle"
                     style="width: 56px; height: 56px; object-fit: cover;"
                     onerror="this.src='/images/user.png';" />
                <div>
                    <div class="fw-semibold fs-5">@Model.Profile.VendorName</div>
                    <div class="text-muted small">UserId: @Model.Profile.VendorUserId</div>
                </div>
            </div>
            <div class="mt-3">
                <div class="text-muted small">@L.Get("auth.vendors.email")</div>
                <div>@(Model.Profile.Email ?? "-")</div>
            </div>
            <div class="mt-3">
                <div class="text-muted small">@L.Get("auth.vendors.phone")</div>
                <div>@(Model.Profile.Phone ?? "-")</div>
            </div>
            <div class="mt-3">
                <div class="text-muted small">@L.Get("auth.vendors.registered")</div>
                <div>@Model.Profile.RegisteredAt.ToString("yyyy-MM-dd HH:mm")</div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="glass-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="text-muted small">@L.Get("auth.vendors.verification")</div>
                    <div class="mt-1">
                        <partial name="~/Areas/Admin/Views/Shared/_StatusBadge.cshtml"
                                 model="new AdminStatusBadgeViewModel { Status = Model.Verification.Status.ToString() }" />
                    </div>
                </div>
                <div class="text-end">
                    <div class="text-muted small">@L.Get("auth.vendors.account")</div>
                    <div class="mt-1">
                        <partial name="~/Areas/Admin/Views/Shared/_StatusBadge.cshtml"
                                 model="new AdminStatusBadgeViewModel { Status = Model.Account.Status.ToString() }" />
                    </div>
                </div>
            </div>

            <div class="mt-3">
                <div class="text-muted small">@L.Get("auth.vendors.verifiedBy")</div>
                <div>@(Model.Verification.VerifiedByAdminName ?? Model.Account.StatusChangedByAdminName ?? "-")</div>
            </div>
            <div class="mt-3">
                <div class="text-muted small">@L.Get("auth.vendors.verificationDate")</div>
                <div>@(Model.Verification.VerificationDate?.ToString("yyyy-MM-dd HH:mm") ?? "-")</div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Verification.RejectionReason))
            {
                <div class="mt-3">
                    <div class="text-muted small">@L.Get("auth.vendors.rejectionReason")</div>
                    <div class="text-danger fw-semibold">@Model.Verification.RejectionReason</div>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-4">
        <div class="glass-card p-4 h-100">
            <div class="text-muted small">@L.Get("auth.vendors.orders")</div>
            <div class="fs-4 fw-semibold">@Model.OrdersStats.TotalOrders</div>
            <div class="d-flex flex-wrap gap-2 mt-2">
                <span class="badge bg-success">@L.Get("auth.vendors.delivered"): @Model.OrdersStats.DeliveredOrders</span>
                <span class="badge bg-warning text-dark">@L.Get("auth.vendors.pending"): @Model.OrdersStats.PendingOrders</span>
                <span class="badge bg-danger">@L.Get("auth.vendors.cancelled"): @Model.OrdersStats.CancelledOrders</span>
                <span class="badge bg-info">@L.Get("auth.vendors.inProgress"): @Model.OrdersStats.InProgressOrders</span>
                <span class="badge bg-primary">@L.Get("auth.vendors.confirmed"): @Model.OrdersStats.ConfirmedOrders</span>
                <span class="badge bg-black">@L.Get("auth.vendors.readyForPickup"): @Model.OrdersStats.ShippedOrders</span>
                <span class="badge bg-secondary">@L.Get("auth.vendors.awaitingApproval"): @Model.OrdersStats.AwaitingOrders</span>
            </div>
            <hr />
            <div class="text-muted small">@L.Get("auth.vendors.revenue")</div>
            <div class="fs-4 fw-semibold">@string.Format(L.Get("auth.vendors.currencyFormat"), Model.RevenueStats.TotalRevenue.ToString("N0"))</div>
            <div class="text-muted small">@L.Get("auth.vendors.deliveredRevenue"): @string.Format(L.Get("auth.vendors.currencyFormat"), Model.RevenueStats.DeliveredRevenue.ToString("N0"))</div>
        </div>
    </div>
</div>

<div class="glass-card p-4 mb-4">
    <h5 class="mb-3"><i class="fa-solid fa-briefcase me-2" style="color: var(--accent-primary);"></i>@L.Get("auth.vendors.business")</h5>
    <div class="row g-3">
        <div class="col-md-6">
            <div class="text-muted small">@L.Get("auth.vendors.workshopNameEn")</div>
            <div class="fw-semibold">@Model.Business.WorkshopNameEn</div>
        </div>
        <div class="col-md-6">
            <div class="text-muted small">@L.Get("auth.vendors.workshopNameAr")</div>
            <div class="fw-semibold">@Model.Business.WorkshopNameAr</div>
        </div>
        <div class="col-md-6">
            <div class="text-muted small">@L.Get("auth.vendors.address")</div>
            <div>@(Model.Business.AddressSummary ?? "-")</div>
        </div>
        <div class="col-md-6">
            <div class="text-muted small">@L.Get("auth.vendors.rating")</div>
            <div>@(Model.Business.Rating?.ToString("0.0") ?? "-")</div>
        </div>
        <div class="col-12">
            <div class="text-muted small">@L.Get("auth.vendors.descriptionEn")</div>
            <div>@Model.Business.DescriptionEn</div>
        </div>
        <div class="col-12">
            <div class="text-muted small">@L.Get("auth.vendors.descriptionAr")</div>
            <div>@Model.Business.DescriptionAr</div>
        </div>
    </div>
</div>

<div class="glass-card p-4 mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 mb-3">
        <h5 class="mb-0"><i class="fa-solid fa-shield-halved me-2" style="color: var(--accent-primary);"></i>@L.Get("auth.vendors.actions")</h5>
        <div class="d-flex gap-2 flex-wrap">
            @if (Model.Actions.CanApprove)
            {
                <form method="post" asp-area="Admin" asp-controller="Vendors" asp-action="Approve" class="d-inline js-confirm" data-title="@L.Get("auth.vendors.confirmApprove")" data-text="@L.Get("auth.vendors.confirmApproveText")">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="workshopId" value="@Model.Profile.WorkshopId" />
                    <button type="submit" class="btn btn-premium btn-premium-primary">
                        <i class="fa-solid fa-circle-check"></i> @L.Get("auth.vendors.approve")
                    </button>
                </form>
            }
            @if (Model.Actions.CanReject)
            {
                <button type="button" class="btn btn-premium btn-premium-secondary" data-bs-toggle="modal" data-bs-target="#rejectModal">
                    <i class="fa-solid fa-circle-xmark"></i> @L.Get("auth.vendors.reject")
                </button>
            }
            @if (Model.Actions.CanSuspend)
            {
                <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#suspendModal">
                    <i class="fa-solid fa-ban"></i> @L.Get("auth.vendors.suspend")
                </button>
            }
            else
            {
                <form method="post" asp-area="Admin" asp-controller="Vendors" asp-action="Activate" class="d-inline js-confirm" data-title="@L.Get("auth.vendors.confirmUnsuspend")" data-text="@L.Get("auth.vendors.confirmUnsuspendText")">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="workshopId" value="@Model.Profile.WorkshopId" />
                    <button type="submit" class="btn btn-outline-success">
                        <i class="fa-solid fa-circle-check"></i> @L.Get("auth.vendors.unsuspend")
                    </button>
                </form>
            }

        </div>
    </div>
    <div class="text-muted small">@L.Get("auth.vendors.actionsAudit")</div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="glass-card p-4 h-100">
            <h5 class="mb-3"><i class="fa-solid fa-list-check me-2" style="color: var(--accent-primary);"></i>@L.Get("auth.vendors.verificationHistory")</h5>
            <div class="table-responsive">
                <table class="table table-premium mb-0">
                    <thead>
                        <tr>
                            <th>@L.Get("auth.vendors.colDate")</th>
                            <th>@L.Get("auth.vendors.colChange")</th>
                            <th>@L.Get("auth.vendors.colAdmin")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.VerificationHistory.Count == 0)
                        {
                            <tr><td colspan="3" class="text-muted">@L.Get("auth.vendors.noHistory")</td></tr>
                        }
                        else
                        {
                            foreach (var h in Model.VerificationHistory)
                            {
                                <tr>
                                    <td>@h.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@h.OldStatus → @h.NewStatus</td>
                                    <td>@(h.AdminName ?? "-")</td>
                                </tr>
                                @if (!string.IsNullOrWhiteSpace(h.RejectionReason))
                                {
                                    <tr>
                                        <td colspan="3" class="text-danger small">@L.Get("auth.vendors.reason"): @h.RejectionReason</td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="glass-card p-4 h-100">
            <h5 class="mb-3"><i class="fa-solid fa-user-shield me-2" style="color: var(--accent-primary);"></i>@L.Get("auth.vendors.statusHistory")</h5>
            <div class="table-responsive">
                <table class="table table-premium mb-0">
                    <thead>
                        <tr>
                            <th>@L.Get("auth.vendors.colDate")</th>
                            <th>@L.Get("auth.vendors.colChange")</th>
                            <th>@L.Get("auth.vendors.colAdmin")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.AccountStatusHistory.Count == 0)
                        {
                            <tr><td colspan="3" class="text-muted">@L.Get("auth.vendors.noHistory")</td></tr>
                        }
                        else
                        {
                            foreach (var h in Model.AccountStatusHistory)
                            {
                                <tr>
                                    <td>@h.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@h.OldStatus → @h.NewStatus</td>
                                    <td>@(h.AdminName ?? "-")</td>
                                </tr>
                                @if (!string.IsNullOrWhiteSpace(h.Reason))
                                {
                                    <tr>
                                        <td colspan="3" class="text-muted small">@L.Get("auth.vendors.reason"): @h.Reason</td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@L.Get("auth.vendors.rejectVendor")</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-area="Admin" asp-controller="Vendors" asp-action="Reject" class="js-confirm" data-title="@L.Get("auth.vendors.confirmReject")" data-text="@L.Get("auth.vendors.confirmRejectText")">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" name="WorkshopId" value="@Model.Profile.WorkshopId" />
                    <div class="mb-3">
                        <label class="form-label">@L.Get("auth.vendors.rejectionReason")</label>
                        <input class="form-control" name="RejectionReason" required maxlength="500" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@L.Get("auth.vendors.notes")</label>
                        <textarea class="form-control" name="Notes" rows="3" maxlength="1000"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-premium btn-premium-secondary" data-bs-dismiss="modal">@L.Get("auth.vendors.cancel")</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="fa-solid fa-circle-xmark"></i> @L.Get("auth.vendors.reject")
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Suspend Modal -->
<div class="modal fade" id="suspendModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@L.Get("auth.vendors.suspendVendor")</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-area="Admin" asp-controller="Vendors" asp-action="Suspend" class="js-confirm" data-title="@L.Get("auth.vendors.confirmSuspend")" data-text="@L.Get("auth.vendors.confirmSuspendText")">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" name="WorkshopId" value="@Model.Profile.WorkshopId" />
                    <div class="mb-3">
                        <label class="form-label">@L.Get("auth.vendors.suspensionReason")</label>
                        <input class="form-control" name="Reason" required maxlength="500" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@L.Get("auth.vendors.notes")</label>
                        <textarea class="form-control" name="Notes" rows="3" maxlength="1000"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-premium btn-premium-secondary" data-bs-dismiss="modal">@L.Get("auth.vendors.cancel")</button>
                    <button type="submit" class="btn btn-outline-danger">
                        <i class="fa-solid fa-ban"></i> @L.Get("auth.vendors.suspend")
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        var _swalYes = '@Html.Raw(L.Get("auth.vendors.confirmYes"))';
        var _swalCancel = '@Html.Raw(L.Get("auth.vendors.confirmCancel"))';

        (function () {
            document.querySelectorAll('form.js-confirm').forEach(function (form) {
                form.addEventListener('submit', function (e) {
                    e.preventDefault();
                    var title = form.getAttribute('data-title') || 'Are you sure?';
                    var text = form.getAttribute('data-text') || '';
                    Swal.fire({
                        title: title,
                        text: text,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonText: _swalYes,
                        cancelButtonText: _swalCancel
                    }).then(function (result) {
                        if (result.isConfirmed) form.submit();
                    });
                });
            });
        })();
    </script>
}
