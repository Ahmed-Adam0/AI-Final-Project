@model Graduation_MVC.Areas.Admin.ViewModels.Dashboard.AdminDashboardViewModel
@using Graduation_Application.IServices.Admin
@inject ILocalizationService LocalizationService
@{
    var currentCulture = LocalizationService.GetCurrentCulture();
    var isArabic = currentCulture == "ar";
    ViewData["Title"] = LocalizationService.Get("auth.sidebar.dashboard");
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h1 class="display-font text-light mb-1">@LocalizationService.Get("auth.dashboard.Admin Dashboard")</h1>
        <p class="text-muted mb-0">@LocalizationService.Get("auth.dashboard.Monitor platform performance, recent activity, and operational insights.")</p>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <div class="d-inline-flex gap-2">
            <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="btn btn-premium btn-premium-secondary">
                <i class="fa-solid fa-cart-shopping"></i> @LocalizationService.Get("auth.dashboard.View Orders")
            </a>
            <a asp-area="Admin" asp-controller="Reports" asp-action="Index" class="btn btn-premium btn-premium-primary">
                <i class="fa-solid fa-file-lines"></i> @LocalizationService.Get("auth.dashboard.Generate Report")
            </a>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    @foreach (var card in Model.SummaryCards)
    {
        <div class="col-12 col-sm-6 col-xl-4">
            <div class="glass-card p-4 h-100">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold" style="letter-spacing: 0.05em;">@LocalizationService.Get("auth.dashboard." + card.Title)</div>
                        <div class="fs-3 fw-bold text-light">@FormatCardValue(card.Value, card.Title, isArabic)</div>
                    </div>
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center bg-light" style="width: 52px; height: 52px; color: var(--accent-primary);">
                        <i class="@card.IconClass fa-lg"></i>
                    </div>
                </div>
                <div class="@card.TrendClass small">
                    <i class="fa-solid fa-arrow-trend-up me-1"></i>@FormatTrendText(card.TrendText, isArabic)
                </div>
            </div>
        </div>
    }
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="glass-card p-4 h-100">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h5 class="mb-0 text-light">@LocalizationService.Get("auth.dashboard.Revenue Overview")</h5>
                <span class="badge bg-primary">@LocalizationService.Get("auth.dashboard.Live Metrics")</span>
            </div>
            <div class="chart-skeleton mb-3" style="min-height: 260px;">
                <canvas id="@Model.RevenueChart.ChartId" height="120"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="glass-card p-4 h-100">
            <h5 class="text-light mb-3">@LocalizationService.Get("auth.dashboard.Quick Actions")</h5>
            <div class="d-grid gap-2">
                @foreach (var action in Model.QuickActions)
                {
                    <a href="@action.Url" class="btn btn-premium @action.CssClass justify-content-start">
                        <i class="@action.IconClass"></i>
                        <span>
                            <strong>@LocalizationService.Get("auth.dashboard." + action.Title)</strong>
                            <small class="d-block opacity-75">@LocalizationService.Get("auth.dashboard." + action.Description)</small>
                        </span>
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="glass-card p-4 h-100">
            <h5 class="text-light mb-3">@LocalizationService.Get("auth.dashboard.Latest Activity")</h5>
            <div class="list-group list-group-flush">
                @foreach (var activity in Model.LatestActivity)
                {
                    <div class="list-group-item bg-transparent px-0 py-3 border-bottom">
                        <div class="d-flex justify-content-between align-items-start gap-3">
                            <div>
                                <div class="fw-semibold text-light">@LocalizationService.Get("auth.dashboard." + activity.Title)</div>
                                <div class="text-muted small">@GetActivityDescription(activity.Description, isArabic)</div>
                            </div>
                            <div class="text-end">
                                <span class="badge @activity.BadgeClass">@LocalizationService.Get("auth.dashboard." + activity.BadgeText)</span>
                                <div class="text-muted small mt-1">@FormatActivityDate(activity.CreatedAt, isArabic)</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="glass-card p-4 h-100">
            <h5 class="text-light mb-3">@LocalizationService.Get("auth.dashboard.Latest Orders")</h5>
            <div class="table-responsive">
                <table class="table table-premium mb-0">
                    <thead>
                        <tr>
                            <th>@LocalizationService.Get("auth.dashboard.Order")</th>
                            <th>@LocalizationService.Get("auth.dashboard.Customer")</th>
                            <th>@LocalizationService.Get("auth.dashboard.Status")</th>
                            <th class="text-end">@LocalizationService.Get("auth.dashboard.Total")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.LatestOrders)
                        {
                            <tr>
                                <td>
                                    <a asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id" class="text-decoration-none hover-indigo text-light fw-semibold">@(isArabic ? ToArabicDigits(order.OrderNumber) : order.OrderNumber)</a>
                                    <div class="text-muted small">@order.VendorName</div>
                                </td>
                                <td>@order.CustomerName</td>
                                <td><span class="badge bg-secondary">@TranslateStatus(order.Status)</span></td>
                                <td class="text-end fw-semibold">@FormatCurrency(order.TotalAmount, isArabic)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="glass-card p-4 h-100">
            <h5 class="text-light mb-3">@LocalizationService.Get("auth.dashboard.Latest Vendors")</h5>
            <div class="table-responsive">
                <table class="table table-premium mb-0">
                    <thead>
                        <tr>
                            <th>@LocalizationService.Get("auth.dashboard.Vendor")</th>
                            <th>@LocalizationService.Get("auth.dashboard.Orders")</th>
                            <th class="text-end">@LocalizationService.Get("auth.dashboard.Revenue")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var vendor in Model.LatestVendors)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold text-light">@(isArabic ? vendor.NameAr : vendor.Name)</div>
                                    <div class="text-muted small">@vendor.Email</div>
                                </td>
                                <td>@(isArabic ? ToArabicDigits(vendor.OrdersCount.ToString()) : vendor.OrdersCount.ToString())</td>
                                <td class="text-end fw-semibold">@FormatCurrency(vendor.Revenue, isArabic)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="glass-card p-4 h-100">
            <h5 class="text-light mb-3">@LocalizationService.Get("auth.dashboard.Latest Reviews")</h5>
            @foreach (var review in Model.LatestReviews)
            {
                <div class="mb-3 pb-3 border-bottom">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="fw-semibold text-light">@review.CustomerName</div>
                            <div class="text-muted small">@review.ProductName</div>
                        </div>
                        <div class="text-warning">
                            @for (var i = 0; i < review.Rating; i++) { <i class="fa-solid fa-star"></i> }
                        </div>
                    </div>
                    <div class="text-muted small mt-2">@review.Comment</div>
                </div>
            }
            <h5 class="text-light mt-4 mb-3">@LocalizationService.Get("auth.dashboard.Latest Reports")</h5>
            @foreach (var report in Model.LatestReports)
            {
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div>
                        <div class="fw-semibold text-light">@(isArabic ? report.Title.Replace("Product report", "بلاغ منتج") : report.Title)</div>
                        <div class="text-muted small">@(isArabic ? "منتج" : report.Type)</div>
                    </div>
                    <a href="@report.DownloadUrl" class="btn btn-sm btn-premium btn-premium-secondary">@LocalizationService.Get("auth.dashboard.Download")</a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        (function () {
            var revenueCanvas = document.getElementById('@Model.RevenueChart.ChartId');
            if (revenueCanvas) {
                new Chart(revenueCanvas, {
                    type: 'line',
                    data: {
                        labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueChart.Labels)),
                        datasets: [{
                            label: '@(isArabic ? "اتجاه الأرباح" : Model.RevenueChart.Title)',
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueChart.Values)),
                            borderColor: '#0d6efd',
                            backgroundColor: 'rgba(13,110,253,0.12)',
                            tension: 0.35,
                            fill: true
                        }]
                    },
                    options: { responsive: true, maintainAspectRatio: false }
                });
            }
        })();
    </script>
}

@functions {
    public string ToArabicDigits(string input)
    {
        if (string.IsNullOrEmpty(input)) return input;
        var english = "0123456789";
        var arabic = "٠١٢٣٤٥٦٧٨٩";
        var result = new System.Text.StringBuilder();
        foreach (var ch in input)
        {
            var idx = english.IndexOf(ch);
            result.Append(idx != -1 ? arabic[idx] : ch);
        }
        return result.ToString();
    }

    public string ToWesternDigits(string input)
    {
        if (string.IsNullOrEmpty(input)) return input;
        var english = "0123456789";
        var arabic = "٠١٢٣٤٥٦٧٨٩";
        var result = new System.Text.StringBuilder();
        foreach (var ch in input)
        {
            var idx = arabic.IndexOf(ch);
            result.Append(idx != -1 ? english[idx] : ch);
        }
        return result.ToString();
    }

    public string FormatCurrency(decimal amount, bool isArabic)
    {
        var formatted = amount.ToString("N0");
        var val = isArabic ? ToArabicDigits(formatted) : formatted;
        return string.Format(LocalizationService.Get("auth.dashboard.currencyFormat"), val);
    }

    public string FormatCardValue(string value, string title, bool isArabic)
    {
        if (string.IsNullOrEmpty(value)) return value;
        
        if (title == "Total Revenue")
        {
            var digits = new string(value.Where(c => char.IsDigit(c) || c == ',' || c == '.' || c == '٬' || c == '٫').ToArray()).Trim();
            if (isArabic)
            {
                var val = ToArabicDigits(digits.Replace(",", "٬"));
                return string.Format(LocalizationService.Get("auth.dashboard.currencyFormat"), val);
            }
            else
            {
                var val = ToWesternDigits(digits.Replace("٬", ","));
                return string.Format(LocalizationService.Get("auth.dashboard.currencyFormat"), val);
            }
        }
        
        return isArabic ? ToArabicDigits(value) : value;
    }

    public string FormatTrendText(string trendText, bool isArabic)
    {
        if (string.IsNullOrEmpty(trendText)) return trendText;

        if (trendText.Contains("pending"))
        {
            var num = new string(trendText.Where(char.IsDigit).ToArray());
            var numStr = isArabic ? ToArabicDigits(num) : num;
            return string.Format(LocalizationService.Get("auth.dashboard.trendPending"), numStr);
        }

        var val = LocalizationService.Get("auth.dashboard." + trendText);
        return val != "auth.dashboard." + trendText ? val : trendText;
    }

    public string GetActivityDescription(string desc, bool isArabic)
    {
        if (string.IsNullOrEmpty(desc)) return desc;
        if (desc.StartsWith("Latest order"))
        {
            var parts = desc.Split("status:");
            var orderId = new string(desc.TakeWhile(c => c != 's').Where(char.IsDigit).ToArray());
            var status = parts.Length > 1 ? parts[1].Trim() : "";
            var translatedStatus = TranslateStatus(status);
            var idStr = isArabic ? ToArabicDigits(orderId) : orderId;
            return string.Format(LocalizationService.Get("auth.dashboard.activityLatestOrder"), idStr, translatedStatus);
        }
        if (desc.StartsWith("Latest review by"))
        {
            var name = desc.Replace("Latest review by", "").Trim();
            return string.Format(LocalizationService.Get("auth.dashboard.activityLatestReview"), name);
        }
        if (desc.StartsWith("Latest product report"))
        {
            var reason = desc.Replace("Latest product report:", "").Trim();
            return string.Format(LocalizationService.Get("auth.dashboard.activityLatestReport"), reason);
        }

        var val = LocalizationService.Get("auth.dashboard." + desc);
        return val != "auth.dashboard." + desc ? val : desc;
    }

    public string TranslateStatus(string status)
    {
        if (string.IsNullOrEmpty(status)) return status;
        var val = LocalizationService.Get("auth.dashboard." + status);
        return val != "auth.dashboard." + status ? val : status;
    }

    public string FormatActivityDate(DateTime date, bool isArabic)
    {
        var formatted = date.ToString("MMM dd, HH:mm");
        return isArabic ? ToArabicDigits(formatted) : formatted;
    }
}
