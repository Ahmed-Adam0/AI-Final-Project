<header class="admin-navbar">
    <button class="admin-nav-toggle" id="sidebarToggle" type="button" aria-label="Toggle Sidebar">
        <i class="fa-solid fa-bars"></i>
    </button>

    <div class="d-none d-md-block text-muted small">
        <span class="text-uppercase" style="letter-spacing: 0.06em;">Admin Panel</span>
    </div>

    <div class="d-flex align-items-center gap-3 ms-auto">
        <span class="d-none d-lg-inline-block text-muted" style="font-size: 0.85rem;">
            <i class="fa-solid fa-user-shield me-1"></i>
            <strong class="text-dark">Administrator</strong>
        </span>

        <div class="dropdown">
            <button class="btn btn-premium btn-premium-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fa-solid fa-bell"></i>
                <span class="d-none d-md-inline">Notifications</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><span class="dropdown-item-text text-muted small">No new notifications</span></li>
            </ul>
        </div>

        <div class="dropdown">
            <button class="btn btn-premium btn-premium-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fa-solid fa-circle-user"></i>
                <span class="d-none d-md-inline">Profile</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><span class="dropdown-item-text text-muted small">Admin Profile (placeholder)</span></li>
                <li><hr class="dropdown-divider" /></li>
                <li><a class="dropdown-item" href="#"><i class="fa-solid fa-user-gear me-2"></i>Account Settings</a></li>
            </ul>
        </div>

        @* <a href="#" class="btn btn-premium btn-premium-primary btn-sm">
            <i class="fa-solid fa-right-from-bracket"></i>
            <span class="d-none d-md-inline">Logout</span>
        </a> *@
        <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="btn btn-premium btn-premium-primary btn-sm">
                <i class="fa-solid fa-right-from-bracket"></i>
                <span class="d-none d-md-inline">Logout</span>
            </button>
        </form>
    </div>
</header>
