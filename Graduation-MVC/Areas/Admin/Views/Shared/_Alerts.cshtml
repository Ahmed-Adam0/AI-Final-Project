@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-premium alert-premium-success mb-4 auto-dismiss-alert" role="alert">
        <i class="fa-solid fa-circle-check"></i>
        <div>@TempData["SuccessMessage"]</div>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-premium alert-premium-danger mb-4" role="alert">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <div>@TempData["ErrorMessage"]</div>
    </div>
}

@if (TempData["WarningMessage"] != null)
{
    <div class="alert alert-premium alert-premium-warning mb-4" role="alert">
        <i class="fa-solid fa-circle-exclamation"></i>
        <div>@TempData["WarningMessage"]</div>
    </div>
}

@if (TempData["InfoMessage"] != null)
{
    <div class="alert alert-premium alert-premium-info mb-4" role="alert">
        <i class="fa-solid fa-circle-info"></i>
        <div>@TempData["InfoMessage"]</div>
    </div>
}
