@model Graduation_MVC.Areas.Admin.ViewModels.Shared.AdminStatusBadgeViewModel
@using Graduation_Application.IServices.Admin
@inject ILocalizationService LocalizationService

@{
    var statusKey = "status." + Model.Status.Trim().ToLowerInvariant();
    var localizedDisplayText = LocalizationService.Get(statusKey);
    // Fallback if not found (LocalizationService returns key if missing)
    if (localizedDisplayText == statusKey)
    {
        localizedDisplayText = string.IsNullOrWhiteSpace(Model.DisplayText) ? Model.Status : Model.DisplayText;
    }
    var displayText = localizedDisplayText;
    
    var cssClass = Model.CssClass;

    if (string.IsNullOrWhiteSpace(cssClass))
    {
        cssClass = Model.Status.Trim().ToLowerInvariant() switch
        {
            "active" => "badge-status-active",
            "inactive" => "badge-status-inactive",
            "approved" => "badge-status-active",
            "rejected" => "badge-status-suspended",
            "suspended" => "badge-status-hidden",
            "pending" => "badge-status-pending",
            "hidden" => "badge-status-hidden",
            "resolved" => "badge-status-resolved",
            _ => "badge-status-inactive"
        };
    }

    var icon = Model.IconClass ?? Model.Status.Trim().ToLowerInvariant() switch
    {
        "active" => "fa-solid fa-circle-check",
        "inactive" => "fa-solid fa-circle-minus",
        "approved" => "fa-solid fa-circle-check",
        "rejected" => "fa-solid fa-circle-xmark",
        "suspended" => "fa-solid fa-ban",
        "pending" => "fa-solid fa-hourglass-half",
        "hidden" => "fa-solid fa-eye-slash",
        "resolved" => "fa-solid fa-check-double",
        _ => "fa-solid fa-circle"
    };
}

<span class="badge-status @cssClass">
    <i class="@icon"></i> @displayText
</span>
