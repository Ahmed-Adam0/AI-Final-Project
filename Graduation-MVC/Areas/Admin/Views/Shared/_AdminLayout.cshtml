@using Graduation_Application.IServices.Admin
@inject ILocalizationService LocalizationService
@{
    var currentCulture = LocalizationService.GetCurrentCulture();
    var isArabic = currentCulture == "ar";
    var htmlDir = isArabic ? "rtl" : "ltr";
    var htmlLang = currentCulture;
}
<!DOCTYPE html>
<html lang="@htmlLang" dir="@htmlDir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel | HomeAi</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    @if (isArabic)
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    }
    else
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    }
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <partial name="_AdminStyles" />

    <style>
        @if (isArabic)
        {
            <text>
            .admin-sidebar { 
                right: 0; 
                left: auto; 
                border-left: 1px solid #343a40; 
                border-right: none; 
            }
            .admin-layout-wrapper { 
                margin-right: 280px; 
                margin-left: 0; 
            }
            .dropdown-menu-end {
                --bs-position: start !important;
                right: auto !important;
                left: 0 !important;
            }
            @@media (max-width: 991.98px) {
                .admin-sidebar { 
                    transform: translateX(100%); 
                }
                .admin-sidebar.show { 
                    transform: translateX(0); 
                }
                .admin-layout-wrapper { 
                    margin-right: 0; 
                    margin-left: 0; 
                }
            }
            </text>
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <partial name="_Sidebar" />

    <div class="admin-layout-wrapper">
        <partial name="_Navbar" />

        <main class="admin-content" role="main">
            <partial name="_Alerts" />
            @RenderBody()
        </main>

        <footer class="admin-footer">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
                <span>&copy; @DateTime.UtcNow.Year HomeAi Marketplace — Admin Console</span>
                <span class="text-muted">Built for scalable module management</span>
            </div>
        </footer>
    </div>

    <partial name="_AdminScripts" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
