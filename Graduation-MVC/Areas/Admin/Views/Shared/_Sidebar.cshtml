@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;

    string LinkClass(string targetController, string targetAction, bool disabled = false)
    {
        var isActive =
            string.Equals(controller, targetController, StringComparison.OrdinalIgnoreCase)
            && string.Equals(action, targetAction, StringComparison.OrdinalIgnoreCase);

        return "sidebar-link" + (isActive ? " active" : "") + (disabled ? " disabled-module" : "");
    }
}

<aside class="admin-sidebar" id="sidebar">
    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="sidebar-brand">
        <i class="fa-solid fa-house-laptop"></i>
        <span>HomeAi <small style="font-size: 0.6rem; letter-spacing: 0.05em; text-transform: uppercase;">Admin</small></span>
    </a>

    <ul class="sidebar-menu">
        <li class="sidebar-section-title">Main</li>
        <li class="sidebar-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="@LinkClass("Dashboard", "Index")"><i class="fa-solid fa-gauge-high"></i><span>Dashboard</span></a></li>
        <li class="sidebar-item"><a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="@LinkClass("Orders", "Index")"><i class="fa-solid fa-cart-shopping"></i><span>Orders</span></a></li>
        <li class="sidebar-item"><a asp-area="Admin" asp-controller="Vendors" asp-action="Index" class="@LinkClass("Vendors", "Index")"><i class="fa-solid fa-store"></i><span>Vendors</span></a></li>
        <li class="sidebar-item"><a asp-area="Admin" asp-controller="Analytics" asp-action="Index" class="@LinkClass("Analytics", "Index")"><i class="fa-solid fa-chart-line"></i><span>Analytics</span></a></li>
        <li class="sidebar-item"><a asp-area="Admin" asp-controller="Reports" asp-action="Index" class="@LinkClass("Reports", "Index")"><i class="fa-solid fa-flag"></i><span>Reports</span></a></li>
        <li class="sidebar-item"><a asp-area="Admin" asp-controller="Settings" asp-action="Index" class="@LinkClass("Settings", "Index")"><i class="fa-solid fa-gear"></i><span>Settings</span></a></li>

        <li class="sidebar-section-title">Catalog</li>
        <li class="sidebar-item"><a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="@LinkClass("Categories", "Index")"><i class="fa-solid fa-layer-group"></i><span>Categories</span></a></li>
        <li class="sidebar-item"><a asp-area="Admin" asp-controller="Banners" asp-action="Index" class="@LinkClass("Banners", "Index")"><i class="fa-solid fa-images"></i><span>Banners</span></a></li>
        <li class="sidebar-item"><a asp-area="Admin" asp-controller="Products" asp-action="Index" class="@LinkClass("Products", "Index")"><i class="fa-solid fa-cubes"></i><span>Products</span></a></li>
        <li class="sidebar-item"><a asp-area="Admin" asp-controller="Products" asp-action="Reported" class="@LinkClass("Products", "Reported")"><i class="fa-solid fa-flag"></i><span>Product Reports</span></a></li>
        <li class="sidebar-item"><a asp-area="Admin" asp-controller="Reviews" asp-action="Index" class="@LinkClass("Reviews", "Index")"><i class="fa-solid fa-star"></i><span>Reviews</span></a></li>
        <li class="sidebar-item"><a asp-area="Admin" asp-controller="Reviews" asp-action="Reported" class="@LinkClass("Reviews", "Reported")"><i class="fa-solid fa-triangle-exclamation"></i><span>Reported Reviews</span></a></li>
        <li class="sidebar-item"><a asp-area="Admin" asp-controller="Faq" asp-action="Index" class="@LinkClass("Faq", "Index")"><i class="fa-solid fa-circle-question"></i><span>FAQs</span></a></li>

