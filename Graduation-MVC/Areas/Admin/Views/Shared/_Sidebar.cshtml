@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;

    string LinkClass(bool isActive, bool disabled = false)
    {
        return "sidebar-link" + (isActive ? " active" : "") + (disabled ? " disabled-module" : "");
    }

    var isProductsActive = string.Equals(controller, "Products", StringComparison.OrdinalIgnoreCase)
        && !string.Equals(action, "Reported", StringComparison.OrdinalIgnoreCase);
    var isReportsActive = string.Equals(controller, "Products", StringComparison.OrdinalIgnoreCase)
        && string.Equals(action, "Reported", StringComparison.OrdinalIgnoreCase);
}

<aside class="admin-sidebar" id="sidebar">
    <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="sidebar-brand">
        <i class="fa-solid fa-house-laptop"></i>
        <span>HomeAi <small style="font-size: 0.6rem; letter-spacing: 0.05em; text-transform: uppercase;">Admin</small></span>
    </a>

    <ul class="sidebar-menu">
        <li class="sidebar-section-title">Main</li>
        <li class="sidebar-item">
            <a href="#" class="@LinkClass(false, disabled: true)">
                <i class="fa-solid fa-gauge-high"></i><span>Dashboard</span>
            </a>
        </li>
        <li class="sidebar-item">
            <a href="#" class="@LinkClass(false, disabled: true)">
                <i class="fa-solid fa-users"></i><span>Users</span>
            </a>
        </li>
        <li class="sidebar-item">
            <a href="#" class="@LinkClass(false, disabled: true)">
                <i class="fa-solid fa-store"></i><span>Vendors</span>
            </a>
        </li>
        <li class="sidebar-item">
            <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="@LinkClass(isProductsActive)">
                <i class="fa-solid fa-cubes"></i><span>Products</span>
            </a>
        </li>
        <li class="sidebar-item">
            <a href="#" class="@LinkClass(false, disabled: true)">
                <i class="fa-solid fa-tags"></i><span>Categories</span>
            </a>
        </li>
        <li class="sidebar-item">
            <a href="#" class="@LinkClass(false, disabled: true)">
                <i class="fa-solid fa-star"></i><span>Reviews</span>
            </a>
        </li>
        <li class="sidebar-item">
            <a href="#" class="@LinkClass(false, disabled: true)">
                <i class="fa-solid fa-cart-shopping"></i><span>Orders</span>
            </a>
        </li>
        <li class="sidebar-item">
            <a asp-area="Admin" asp-controller="Products" asp-action="Reported" class="@LinkClass(isReportsActive)">
                <i class="fa-solid fa-flag"></i><span>Reports</span>
            </a>
        </li>
        <li class="sidebar-item">
            <a href="#" class="@LinkClass(false, disabled: true)">
                <i class="fa-solid fa-chart-line"></i><span>Analytics</span>
            </a>
        </li>
        <li class="sidebar-item">
            <a href="#" class="@LinkClass(false, disabled: true)">
                <i class="fa-solid fa-gear"></i><span>Settings</span>
            </a>
        </li>

        <li class="sidebar-section-title">System</li>
        <li class="sidebar-item">
            <a href="/" class="sidebar-link">
                <i class="fa-solid fa-arrow-left"></i><span>Main Site</span>
            </a>
        </li>
    </ul>
</aside>
