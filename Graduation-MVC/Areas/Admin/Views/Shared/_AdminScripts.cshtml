// Generic confirm handler for forms with .js-confirm-form
$(document).ready(function () {
    $(document).on('submit', 'form.js-confirm-form', function (e) {
        e.preventDefault();
        var form = this;
        var title = $(form).data('confirm-title') || 'Confirm';
        var message = $(form).data('confirm-message') || 'Are you sure?';

        // show custom modal
        var modal = $('<div>').css({ position: 'fixed', inset: 0, background: 'rgba(0,0,0,0.45)', zIndex: 10000, display: 'flex', alignItems: 'center', justifyContent: 'center' });
        var box = $('<div>').css({ background: '#1e1e2a', padding: '20px', borderRadius: '8px', minWidth: '320px', color: '#fff' });
        box.append('<div class="fw-semibold mb-2">' + title + '</div>');
        box.append('<div class="text-muted small mb-3">' + message + '</div>');
        var btns = $('<div class="d-flex justify-content-end gap-2">');
        var cancel = $('<button class="btn btn-premium btn-premium-secondary">الغاء</button>');
        var ok = $('<button class="btn btn-premium btn-premium-primary">موافق</button>');
        btns.append(cancel).append(ok);
        box.append(btns);
        modal.append(box);
        $('body').append(modal);

        cancel.on('click', function () { modal.remove(); });
        ok.on('click', function () {
            modal.remove();
            // submit the form via ajax to show toast on success/failure
            var formData = $(form).serialize();
            $.post($(form).attr('action'), formData)
                .done(function (resp) {
                    showToast('تمت العملية بنجاح.', 'success');
                    // Optionally redirect or refresh
                    setTimeout(function () { location.reload(); }, 900);
                })
                .fail(function (xhr) {
                    var msg = 'فشلت العملية.';
                    if (xhr && xhr.responseText) msg = xhr.responseText;
                    showToast(msg, 'error');
                });
        });
    });
});


