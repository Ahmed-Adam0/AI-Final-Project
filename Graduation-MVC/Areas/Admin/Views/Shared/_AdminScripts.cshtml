        }

        window.AdminPanel = window.AdminPanel || {};
        window.AdminPanel.confirmAction = function (message) {
            return window.confirm(message || 'Are you sure?');
        };

        // Auto-dismiss success alerts after 4 seconds
        $(document).ready(function () {
            var autoDismissAlerts = $('.auto-dismiss-alert');
            if (autoDismissAlerts.length > 0) {
                setTimeout(function () {
                    autoDismissAlerts.fadeTo(500, 0).slideUp(500, function () {
                        $(this).remove();
                    });
                }, 4000);
            }
        });
    })();
</script>

<script>
    $(document).ready(function() {
        @if (TempData["SuccessMessage"] != null)
        {
            <text>showToast('@TempData["SuccessMessage"]', 'success');</text>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <text>showToast('@TempData["ErrorMessage"]', 'error');</text>
        }
        @if (TempData["WarningMessage"] != null)
        {
            <text>showToast('@TempData["WarningMessage"]', 'warning');</text>
        }
        @if (TempData["InfoMessage"] != null)
        {
            <text>showToast('@TempData["InfoMessage"]', 'info');</text>
        }
    });

    function showToast(message, type) {
        var bgColor = type === 'success' ? 'var(--color-success)' : type === 'warning' ? 'var(--color-warning)' : type === 'info' ? 'var(--color-info)' : 'var(--color-danger)';
        var icon = type === 'success' ? 'fa-circle-check' : type === 'warning' ? 'fa-circle-exclamation' : type === 'info' ? 'fa-circle-info' : 'fa-triangle-exclamation';

        var toast = $('<div>')
            .css({
                position: 'fixed',
                top: '20px',
                right: '20px',
                zIndex: 9999,
                background: bgColor,
                color: '#fff',
                padding: '12px 20px',
                borderRadius: '8px',
                display: 'flex',
                alignItems: 'center',
                gap: '10px',
                boxShadow: '0 4px 12px rgba(0,0,0,0.15)',
                minWidth: '280px'
            })
            .html('<i class="fa-solid ' + icon + '"></i> ' + message);

        $('body').append(toast);

        setTimeout(function() {
            toast.fadeOut(500, function() { $(this).remove(); });
        }, 4000);
    }
</script>
