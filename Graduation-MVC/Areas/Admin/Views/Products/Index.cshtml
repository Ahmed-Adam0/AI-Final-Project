@model AdminProductsPageViewModel
@using Graduation_Application.IServices.Admin
@inject ILocalizationService L
@{
    ViewData["Title"] = L.Get("admin.products.title");

    string ResolveImage(string? path) => ProductImageUrlResolver.Resolve(path);
}

<div class="row align-items-center mb-4">
    <div class="col-md-6">
        <h1 class="display-font text-light mb-1">@L.Get("admin.products.heading")</h1>
        <p class="text-muted mb-0">@L.Get("admin.products.subheading")</p>
    </div>
    <div class="col-md-6 text-md-end mt-3 mt-md-0">
        <div class="glass-card px-3 py-2 d-inline-flex align-items-center gap-3">
            <span class="text-muted small">@L.Get("admin.products.total")</span>
            <span class="badge bg-indigo fs-6 font-monospace" style="background-color: var(--accent-primary);">@Model.Products.TotalCount</span>
        </div>
    </div>
</div>

<!-- Filters Panel -->
<div class="glass-card p-4 mb-4">
    <h5 class="text-light mb-3"><i class="fa-solid fa-filter me-2 text-indigo" style="color: var(--accent-primary);"></i>@L.Get("admin.products.filter.title")</h5>
    <form method="get" asp-area="Admin" asp-controller="Products" asp-action="Index">
        <input type="hidden" name="PageNumber" value="1" />
        <div class="row g-3">
            <!-- Search -->
            <div class="col-md-3">
                <label class="form-label text-muted small">@L.Get("admin.products.filter.search")</label>
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0" style="border-color: var(--border-color); color: var(--text-muted);">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </span>
                    <input type="text" name="Search" class="form-control form-control-premium border-start-0 ps-0" placeholder="@L.Get("admin.products.filter.searchPlaceholder")" value="@Model.Search" />
                </div>
            </div>
            
            <!-- Category -->
            <div class="col-md-3">
                <label class="form-label text-muted small">@L.Get("admin.products.filter.category")</label>
                <select name="CategoryId" class="form-select form-select-premium">
                    <option value="">@L.Get("admin.products.filter.categoryAll")</option>
                    @foreach (var cat in Model.Categories)
                    {
                        if (Model.CategoryId == cat.Id)
                        {
                            <option value="@cat.Id" selected="selected">@cat.NameEn (@cat.NameAr)</option>
                        }
                        else
                        {
                            <option value="@cat.Id">@cat.NameEn (@cat.NameAr)</option>
                        }
                    }
                </select>
            </div>
            
            <!-- Vendor -->
            <div class="col-md-3">
                <label class="form-label text-muted small">@L.Get("admin.products.filter.vendor")</label>
                <select name="VendorId" class="form-select form-select-premium">
                    <option value="">@L.Get("admin.products.filter.vendorAll")</option>
                    @foreach (var vendor in Model.Vendors)
                    {
                        if (Model.VendorId == vendor.UserId)
                        {
                            <option value="@vendor.UserId" selected="selected">@vendor.FullName (@vendor.Email)</option>
                        }
                        else
                        {
                            <option value="@vendor.UserId">@vendor.FullName (@vendor.Email)</option>
                        }
                    }
                </select>
            </div>
            
            <!-- Status -->
            <div class="col-md-3">
                <label class="form-label text-muted small">@L.Get("admin.products.filter.status")</label>
                <select name="IsHidden" class="form-select form-select-premium">
                    <option value="">@L.Get("admin.products.filter.statusAll")</option>
                    @if (Model.IsHidden == false)
                    {
                        <option value="false" selected="selected">@L.Get("shared.status.visible")</option>
                    }
                    else
                    {
                        <option value="false">@L.Get("shared.status.visible")</option>
                    }
                    @if (Model.IsHidden == true)
                    {
                        <option value="true" selected="selected">@L.Get("shared.status.hidden")</option>
                    }
                    else
                    {
                        <option value="true">@L.Get("shared.status.hidden")</option>
                    }
                </select>
            </div>
        </div>
        
        <div class="d-flex justify-content-end gap-2 mt-3 pt-3 border-top" style="border-color: rgba(255,255,255,0.05) !important;">
            <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="btn btn-premium btn-premium-secondary">
                <i class="fa-solid fa-arrow-rotate-left"></i> @L.Get("admin.products.filter.reset")
            </a>
            <button type="submit" class="btn btn-premium btn-premium-primary">
                <i class="fa-solid fa-check"></i> @L.Get("admin.products.filter.apply")
            </button>
        </div>
    </form>
</div>

<!-- Products Table -->
<div class="glass-card p-4">
    @if (Model.Products == null || !Model.Products.Items.Any())
    {
        <div class="text-center py-5">
            <div class="text-muted mb-3"><i class="fa-solid fa-box-open fa-3x"></i></div>
            <h5 class="text-light">@L.Get("admin.products.empty.title")</h5>
            <p class="text-muted small">@L.Get("admin.products.empty.subtitle")</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-premium">
                <thead>
                    <tr>
                        <th>@L.Get("admin.products.table.info")</th>
                        <th>@L.Get("admin.products.table.category")</th>
                        <th>@L.Get("admin.products.table.vendor")</th>
                        <th>@L.Get("admin.products.table.price")</th>
                        <th>@L.Get("admin.products.table.status")</th>
                        <th>@L.Get("admin.products.table.created")</th>
                        <th class="text-end">@L.Get("admin.products.table.actions")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Products.Items)
                    {
                        <tr>
                            <!-- Image + Name -->
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded overflow-hidden bg-secondary border" style="width: 50px; height: 50px; border-color: var(--border-color) !important;">
                                        <img src="@ResolveImage(item.MainImageUrl)" alt="@(L.GetCurrentCulture() == "ar" ? item.NameAr : item.NameEn)" style="width: 100%; height: 100%; object-fit: cover;" />
                                    </div>
                                    <div>
                                        @if (L.GetCurrentCulture() == "ar")
                                        {
                                            <div class="text-light font-weight-bold">@item.NameAr</div>
                                            <div class="text-muted small">@item.NameEn</div>
                                        }
                                        else
                                        {
                                            <div class="text-light font-weight-bold">@item.NameEn</div>
                                            <div class="text-muted small">@item.NameAr</div>
                                        }
                                    </div>
                                </div>
                            </td>
                            
                            <!-- Category -->
                            <td>
                                <span class="text-light">@(L.GetCurrentCulture() == "ar" ? item.CategoryNameAr : item.CategoryName)</span>
                            </td>
                            
                            <!-- Vendor -->
                            <td>
                                <span class="text-light">@item.VendorName</span>
                            </td>
                            
                            <!-- Price -->
                            <td>
                                <span class="text-indigo font-weight-bold" style="color: var(--accent-secondary);">@string.Format(L.Get("admin.products.currencyFormat"), item.Price.ToString("N0"))</span>
                            </td>
                            
                            <!-- Status -->
                            <td>
                                @if (item.IsActive && !item.IsHidden)
                                {
                                    <span class="badge-status badge-status-active">
                                        <i class="fa-solid fa-circle-check"></i> @L.Get("shared.status.active")
                                    </span>
                                }
                                else if (!item.IsActive)
                                {
                                    <span class="badge-status badge-status-inactive">
                                        <i class="fa-solid fa-circle-minus"></i> @L.Get("shared.status.inactive")
                                    </span>
                                }
                                else if (item.IsHidden)
                                {
                                    <span class="badge-status badge-status-hidden">
                                        <i class="fa-solid fa-eye-slash"></i> @L.Get("shared.status.hidden")
                                    </span>
                                }
                            </td>
                            
                            <!-- Created At -->
                            <td>
                                <span class="text-muted small">@item.CreatedAt.ToString("yyyy-MM-dd")</span>
                            </td>
                            
                            <!-- Actions -->
                            <td>
                                <div class="d-flex justify-content-end gap-2 align-items-center">
                                    <a asp-area="Admin" asp-controller="Products" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-premium btn-premium-secondary" title="@L.Get("admin.products.action.details")">
                                        <i class="fa-solid fa-info-circle"></i>
                                    </a>
                                    
                                    @if (item.IsActive && !item.IsHidden)
                                    {
                                        <form asp-area="Admin" asp-controller="Products" asp-action="Deactivate" asp-route-id="@item.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-warning" style="border-radius: 8px;" title="@L.Get("admin.products.action.deactivate")">
                                                <i class="fa-solid fa-pause"></i>
                                            </button>
                                        </form>
                                        <form asp-area="Admin" asp-controller="Products" asp-action="Hide" asp-route-id="@item.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" style="border-radius: 8px;" title="@L.Get("admin.products.action.hide")">
                                                <i class="fa-solid fa-eye-slash"></i>
                                            </button>
                                        </form>
                                    }
                                    else if (!item.IsActive)
                                    {
                                        <form asp-area="Admin" asp-controller="Products" asp-action="Activate" asp-route-id="@item.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-success" style="border-radius: 8px;" title="@L.Get("admin.products.action.activate")">
                                                <i class="fa-solid fa-play"></i>
                                            </button>
                                        </form>
                                    }
                                    else if (item.IsHidden)
                                    {
                                        <form asp-area="Admin" asp-controller="Products" asp-action="Unhide" asp-route-id="@item.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-primary" style="border-radius: 8px;" title="@L.Get("admin.products.action.restore")">
                                                <i class="fa-solid fa-eye"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        <!-- Pagination Controls -->
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center mt-4 pt-3 border-top" style="border-color: rgba(255,255,255,0.05) !important;">
            <div class="text-muted small mb-3 mb-sm-0">
                @string.Format(L.Get("admin.products.pagination.info"), Model.Products.PageNumber, Model.Products.TotalPages, Model.Products.TotalCount)
            </div>
            
            <nav aria-label="Products navigation">
                <ul class="pagination pagination-premium mb-0">
                    <!-- Previous -->
                    @if (Model.Products.HasPreviousPage)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Index", "Products", new { area = "Admin", PageNumber = Model.Products.PageNumber - 1, Search = Model.Search, CategoryId = Model.CategoryId, VendorId = Model.VendorId, IsHidden = Model.IsHidden })">
                                <i class="fa-solid fa-chevron-left"></i>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <span class="page-link"><i class="fa-solid fa-chevron-left"></i></span>
                        </li>
                    }
                    
                    <!-- Page Numbers -->
                    @for (int i = 1; i <= Model.Products.TotalPages; i++)
                    {
                        if (i == Model.Products.PageNumber)
                        {
                            <li class="page-item active">
                                <span class="page-link">@i</span>
                            </li>
                        }
                        else
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Index", "Products", new { area = "Admin", PageNumber = i, Search = Model.Search, CategoryId = Model.CategoryId, VendorId = Model.VendorId, IsHidden = Model.IsHidden })">@i</a>
                            </li>
                        }
                    }
                    
                    <!-- Next -->
                    @if (Model.Products.HasNextPage)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Index", "Products", new { area = "Admin", PageNumber = Model.Products.PageNumber + 1, Search = Model.Search, CategoryId = Model.CategoryId, VendorId = Model.VendorId, IsHidden = Model.IsHidden })">
                                <i class="fa-solid fa-chevron-right"></i>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <span class="page-link"><i class="fa-solid fa-chevron-right"></i></span>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    }
</div>
