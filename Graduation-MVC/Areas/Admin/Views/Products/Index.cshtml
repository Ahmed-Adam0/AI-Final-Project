@model AdminProductsPageViewModel
@{
    ViewData["Title"] = "Manage Products";

    string ResolveImage(string? path) => ProductImageUrlResolver.Resolve(path);
}

<div class="row align-items-center mb-4">
    <div class="col-md-6">
        <h1 class="display-font text-light mb-1">Products Management</h1>
        <p class="text-muted mb-0">Browse, filter, and moderate products on the marketplace.</p>
    </div>
    <div class="col-md-6 text-md-end mt-3 mt-md-0">
        <div class="glass-card px-3 py-2 d-inline-flex align-items-center gap-3">
            <span class="text-muted small">Total Products:</span>
            <span class="badge bg-indigo fs-6 font-monospace" style="background-color: var(--accent-primary);">@Model.Products.TotalCount</span>
        </div>
    </div>
</div>

<!-- Filters Panel -->
<div class="glass-card p-4 mb-4">
    <h5 class="text-light mb-3"><i class="fa-solid fa-filter me-2 text-indigo" style="color: var(--accent-primary);"></i>Filter Products</h5>
    <form method="get" asp-area="Admin" asp-controller="Products" asp-action="Index">
        <input type="hidden" name="PageNumber" value="1" />
        <div class="row g-3">
            <!-- Search -->
            <div class="col-md-3">
                <label class="form-label text-muted small">Search Name</label>
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0" style="border-color: var(--border-color); color: var(--text-muted);">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </span>
                    <input type="text" name="Search" class="form-control form-control-premium border-start-0 ps-0" placeholder="Search product name..." value="@Model.Search" />
                </div>
            </div>
            
            <!-- Category -->
            <div class="col-md-3">
                <label class="form-label text-muted small">Category</label>
                <select name="CategoryId" class="form-select form-select-premium">
                    <option value="">All Categories</option>
                    @foreach (var cat in Model.Categories)
                    {
                        if (Model.CategoryId == cat.Id)
                        {
                            <option value="@cat.Id" selected="selected">@cat.NameEn (@cat.NameAr)</option>
                        }
                        else
                        {
                            <option value="@cat.Id">@cat.NameEn (@cat.NameAr)</option>
                        }
                    }
                </select>
            </div>
            
            <!-- Vendor -->
            <div class="col-md-3">
                <label class="form-label text-muted small">Vendor</label>
                <select name="VendorId" class="form-select form-select-premium">
                    <option value="">All Vendors</option>
                    @foreach (var vendor in Model.Vendors)
                    {
                        if (Model.VendorId == vendor.UserId)
                        {
                            <option value="@vendor.UserId" selected="selected">@vendor.FullName (@vendor.Email)</option>
                        }
                        else
                        {
                            <option value="@vendor.UserId">@vendor.FullName (@vendor.Email)</option>
                        }
                    }
                </select>
            </div>
            
            <!-- Status -->
            <div class="col-md-3">
                <label class="form-label text-muted small">Status</label>
                <select name="Status" class="form-select form-select-premium">
                    <option value="">All Statuses</option>
                    @foreach (var status in System.Enum.GetValues<ProductStatus>())
                    {
                        if (Model.Status == status)
                        {
                            <option value="@status" selected="selected">@status.ToString()</option>
                        }
                        else
                        {
                            <option value="@status">@status.ToString()</option>
                        }
                    }
                </select>
            </div>
        </div>
        
        <div class="d-flex justify-content-end gap-2 mt-3 pt-3 border-top" style="border-color: rgba(255,255,255,0.05) !important;">
            <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="btn btn-premium btn-premium-secondary">
                <i class="fa-solid fa-arrow-rotate-left"></i> Reset
            </a>
            <button type="submit" class="btn btn-premium btn-premium-primary">
                <i class="fa-solid fa-check"></i> Apply Filters
            </button>
        </div>
    </form>
</div>

<!-- Products Table -->
<div class="glass-card p-4">
    @if (Model.Products == null || !Model.Products.Items.Any())
    {
        <div class="text-center py-5">
            <div class="text-muted mb-3"><i class="fa-solid fa-box-open fa-3x"></i></div>
            <h5 class="text-light">No products found</h5>
            <p class="text-muted small">Try adjusting your filters or search terms.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-premium">
                <thead>
                    <tr>
                        <th>Product Info</th>
                        <th>Category</th>
                        <th>Vendor</th>
                        <th>Price</th>
                        <th>Status</th>
                        <th>Created At</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Products.Items)
                    {
                        <tr>
                            <!-- Image + Name -->
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded overflow-hidden bg-secondary border" style="width: 50px; height: 50px; border-color: var(--border-color) !important;">
                                        <img src="@ResolveImage(item.MainImageUrl)" alt="@item.NameEn" style="width: 100%; height: 100%; object-fit: cover;" />
                                    </div>
                                    <div>
                                        <div class="text-light font-weight-bold">@item.NameEn</div>
                                        <div class="text-muted small">@item.NameAr</div>
                                    </div>
                                </div>
                            </td>
                            
                            <!-- Category -->
                            <td>
                                <span class="text-light">@item.CategoryName</span>
                            </td>
                            
                            <!-- Vendor -->
                            <td>
                                <span class="text-light">@item.VendorName</span>
                            </td>
                            
                            <!-- Price -->
                            <td>
                                <span class="text-indigo font-weight-bold" style="color: var(--accent-secondary);">@item.Price.ToString("C2")</span>
                            </td>
                            
                            <!-- Status -->
                            <td>
                                @if (item.Status == ProductStatus.Active)
                                {
                                    <span class="badge-status badge-status-active">
                                        <i class="fa-solid fa-circle-check"></i> Active
                                    </span>
                                }
                                else if (item.Status == ProductStatus.Inactive)
                                {
                                    <span class="badge-status badge-status-inactive">
                                        <i class="fa-solid fa-circle-minus"></i> Inactive
                                    </span>
                                }
                                else if (item.Status == ProductStatus.Hidden)
                                {
                                    <span class="badge-status badge-status-hidden">
                                        <i class="fa-solid fa-eye-slash"></i> Hidden
                                    </span>
                                }
                            </td>
                            
                            <!-- Created At -->
                            <td>
                                <span class="text-muted small">@item.CreatedAt.ToString("yyyy-MM-dd")</span>
                            </td>
                            
                            <!-- Actions -->
                            <td>
                                <div class="d-flex justify-content-end gap-2 align-items-center">
                                    <a asp-area="Admin" asp-controller="Products" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-premium btn-premium-secondary" title="View Details">
                                        <i class="fa-solid fa-info-circle"></i>
                                    </a>
                                    
                                    @if (item.Status == ProductStatus.Active)
                                    {
                                        <form asp-area="Admin" asp-controller="Products" asp-action="Deactivate" asp-route-id="@item.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-warning" style="border-radius: 8px;" title="Deactivate Product">
                                                <i class="fa-solid fa-pause"></i>
                                            </button>
                                        </form>
                                        <form asp-area="Admin" asp-controller="Products" asp-action="Hide" asp-route-id="@item.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" style="border-radius: 8px;" title="Hide Product">
                                                <i class="fa-solid fa-eye-slash"></i>
                                            </button>
                                        </form>
                                    }
                                    else if (item.Status == ProductStatus.Inactive)
                                    {
                                        <form asp-area="Admin" asp-controller="Products" asp-action="Activate" asp-route-id="@item.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-success" style="border-radius: 8px;" title="Activate Product">
                                                <i class="fa-solid fa-play"></i>
                                            </button>
                                        </form>
                                    }
                                    else if (item.Status == ProductStatus.Hidden)
                                    {
                                        <form asp-area="Admin" asp-controller="Products" asp-action="Restore" asp-route-id="@item.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-primary" style="border-radius: 8px;" title="Restore (Unhide)">
                                                <i class="fa-solid fa-eye"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        <!-- Pagination Controls -->
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center mt-4 pt-3 border-top" style="border-color: rgba(255,255,255,0.05) !important;">
            <div class="text-muted small mb-3 mb-sm-0">
                Showing page <strong class="text-light">@Model.Products.PageNumber</strong> of <strong class="text-light">@Model.Products.TotalPages</strong> (Total <strong class="text-light">@Model.Products.TotalCount</strong> items)
            </div>
            
            <nav aria-label="Products navigation">
                <ul class="pagination pagination-premium mb-0">
                    <!-- Previous -->
                    @if (Model.Products.HasPreviousPage)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Index", "Products", new { area = "Admin", PageNumber = Model.Products.PageNumber - 1, Search = Model.Search, CategoryId = Model.CategoryId, VendorId = Model.VendorId, Status = Model.Status })">
                                <i class="fa-solid fa-chevron-left"></i>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <span class="page-link"><i class="fa-solid fa-chevron-left"></i></span>
                        </li>
                    }
                    
                    <!-- Page Numbers -->
                    @for (int i = 1; i <= Model.Products.TotalPages; i++)
                    {
                        if (i == Model.Products.PageNumber)
                        {
                            <li class="page-item active">
                                <span class="page-link">@i</span>
                            </li>
                        }
                        else
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Index", "Products", new { area = "Admin", PageNumber = i, Search = Model.Search, CategoryId = Model.CategoryId, VendorId = Model.VendorId, Status = Model.Status })">@i</a>
                            </li>
                        }
                    }
                    
                    <!-- Next -->
                    @if (Model.Products.HasNextPage)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Index", "Products", new { area = "Admin", PageNumber = Model.Products.PageNumber + 1, Search = Model.Search, CategoryId = Model.CategoryId, VendorId = Model.VendorId, Status = Model.Status })">
                                <i class="fa-solid fa-chevron-right"></i>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <span class="page-link"><i class="fa-solid fa-chevron-right"></i></span>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    }
</div>
