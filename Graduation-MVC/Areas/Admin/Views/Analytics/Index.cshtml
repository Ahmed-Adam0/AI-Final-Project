@model Graduation_MVC.Areas.Admin.ViewModels.Analytics.AdminAnalyticsViewModel
@using Graduation_Application.IServices.Admin
@inject ILocalizationService L
@{
    ViewData["Title"] = L.Get("admin.analytics.title");
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h1 class="display-font text-light mb-1">@L.Get("admin.analytics.heading")</h1>
        <p class="text-muted mb-0">@L.Get("admin.analytics.subheading")</p>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <a asp-area="Admin" asp-controller="Analytics" asp-action="Export" class="btn btn-premium btn-premium-primary">
            <i class="fa-solid fa-file-export"></i> @L.Get("admin.analytics.export")
        </a>
    </div>
</div>

<div class="glass-card p-4 mb-4">
    <form method="get" asp-area="Admin" asp-controller="Analytics" asp-action="Index" class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label text-muted small">@L.Get("admin.analytics.filter.from")</label>
            <input type="date" name="fromDate" class="form-control form-control-premium" />
        </div>
        <div class="col-md-4">
            <label class="form-label text-muted small">@L.Get("admin.analytics.filter.to")</label>
            <input type="date" name="toDate" class="form-control form-control-premium" />
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-premium btn-premium-primary">@L.Get("admin.analytics.filter.apply")</button>
            <a asp-area="Admin" asp-controller="Analytics" asp-action="Index" class="btn btn-premium btn-premium-secondary">@L.Get("admin.analytics.filter.reset")</a>
        </div>
    </form>
</div>

<div class="row g-3 mb-4">
    @foreach (var metric in Model.Metrics)
    {
        <div class="col-md-4">
            <div class="glass-card p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div class="text-muted small text-uppercase fw-semibold">@L.Get("auth.dashboard." + metric.Title)</div>
                    <i class="@metric.IconClass text-primary"></i>
                </div>
                <div class="fs-3 fw-bold text-light">
                    @if (metric.Title == "Average Order Value")
                    {
                        @string.Format(L.Get("admin.analytics.currencyFormat"), metric.Value)
                    }
                    else
                    {
                        @metric.Value
                    }
                </div>
                <div class="@metric.TrendClass small mt-1">@L.Get("auth.dashboard." + metric.SubText)</div>
            </div>
        </div>
    }
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="glass-card p-4 h-100">
            <h5 class="text-light mb-3">@L.Get("admin.analytics.ordersChart")</h5>
            <div class="admin-chart-shell">
                <canvas id="@Model.OrdersPerDayChart.ChartId" class="admin-chart-canvas"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="glass-card p-4 h-100">
            <h5 class="text-light mb-3">@L.Get("admin.analytics.revenueChart")</h5>
            <div class="admin-chart-shell">
                <canvas id="@Model.RevenueGrowthChart.ChartId" class="admin-chart-canvas"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="glass-card p-4 h-100">
            <h5 class="text-light mb-3">@L.Get("admin.analytics.rank.titleVendors")</h5>
            <div class="table-responsive">
                <table class="table table-premium mb-0">
                    <thead>
                        <tr>
                            <th>@L.Get("admin.analytics.table.rank")</th>
                            <th>@L.Get("admin.analytics.table.vendor")</th>
                            <th>@L.Get("admin.analytics.table.orders")</th>
                            <th class="text-end">@L.Get("admin.analytics.table.revenue")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.TopVendors)
                        {
                            <tr>
                                <td>@item.Rank</td>
                                <td>@item.Name</td>
                                <td>@item.OrdersCount</td>
                                <td class="text-end">@string.Format(L.Get("admin.analytics.currencyFormat"), item.Revenue.ToString("N0"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="glass-card p-4 h-100">
            <h5 class="text-light mb-3">@L.Get("admin.analytics.rank.titleCategories")</h5>
            <div class="table-responsive">
                <table class="table table-premium mb-0">
                    <thead>
                        <tr>
                            <th>@L.Get("admin.analytics.table.rank")</th>
                            <th>@L.Get("admin.analytics.table.category")</th>
                            <th>@L.Get("admin.analytics.table.orders")</th>
                            <th class="text-end">@L.Get("admin.analytics.table.revenue")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.TopCategories)
                        {
                            <tr>
                                <td>@item.Rank</td>
                                <td>@item.Name</td>
                                <td>@item.OrdersCount</td>
                                <td class="text-end">@string.Format(L.Get("admin.analytics.currencyFormat"), item.Revenue.ToString("N0"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        function buildLineChart(canvasId, labels, values, color) {
            var canvas = document.getElementById(canvasId);
            if (!canvas) return;
            new Chart(canvas, {
                type: 'line',
                data: { labels: labels, datasets: [{ data: values, borderColor: color, backgroundColor: color + '22', fill: true, tension: 0.35 }] },
                options: { responsive: true, maintainAspectRatio: false }
            });
        }
        buildLineChart('@Model.OrdersPerDayChart.ChartId', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OrdersPerDayChart.Labels)), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OrdersPerDayChart.Values)), '#0d6efd');
        buildLineChart('@Model.RevenueGrowthChart.ChartId', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueGrowthChart.Labels)), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueGrowthChart.Values)), '#198754');
    </script>
}
