@model AdminBannerFormViewModel
@using Graduation_Application.IServices.Admin
@inject Graduation_Application.IServices.Admin.ILocalizationService L
@{
    ViewData["Title"] = L.Get("admin.banners.create.title");
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h1 class="display-font text-light mb-1">@L.Get("admin.banners.create.title")</h1>
        <p class="text-muted mb-0">@L.Get("admin.banners.create.heading")</p>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <a asp-area="Admin" asp-controller="Banners" asp-action="Index" class="btn btn-premium btn-premium-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i> @L.Get("admin.banners.backToList")
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8 mx-auto">
        <div class="glass-card p-4">
            <form asp-area="Admin" asp-controller="Banners" asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- English Title -->
                <div class="mb-4">
                    <label asp-for="TitleEn" class="form-label text-light font-weight-bold"></label>
                    <input asp-for="TitleEn" class="form-control form-control-premium" placeholder="@L.Get("admin.banners.create.titleEnPlaceholder")" />
                    <span asp-validation-for="TitleEn" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Arabic Title -->
                <div class="mb-4">
                    <label asp-for="TitleAr" class="form-label text-light font-weight-bold"></label>
                    <input asp-for="TitleAr" class="form-control form-control-premium text-end" placeholder="@L.Get("admin.banners.create.titleArPlaceholder")" dir="rtl" />
                    <span asp-validation-for="TitleAr" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- English Description -->
                <div class="mb-4">
                    <label asp-for="DescriptionEn" class="form-label text-light font-weight-bold"></label>
                    <textarea asp-for="DescriptionEn" class="form-control form-control-premium" rows="3" placeholder="@L.Get("admin.banners.create.descEnPlaceholder")"></textarea>
                    <span asp-validation-for="DescriptionEn" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Arabic Description -->
                <div class="mb-4">
                    <label asp-for="DescriptionAr" class="form-label text-light font-weight-bold"></label>
                    <textarea asp-for="DescriptionAr" class="form-control form-control-premium text-end" rows="3" placeholder="@L.Get("admin.banners.create.descArPlaceholder")" dir="rtl"></textarea>
                    <span asp-validation-for="DescriptionAr" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Image File -->
                <div class="mb-4">
                    <label asp-for="ImageFile" class="form-label text-light font-weight-bold"></label>
                    <input asp-for="ImageFile" type="file" class="form-control form-control-premium" accept=".jpg,.jpeg,.png" />
                    <span asp-validation-for="ImageFile" class="text-danger small mt-1 d-block"></span>
                    <div class="form-text text-muted small mt-1">@L.Get("admin.banners.create.imageHint")</div>
                </div>

                <!-- Redirect URL -->
                <div class="mb-4">
                    <label asp-for="RedirectUrl" class="form-label text-light font-weight-bold"></label>
                    <input asp-for="RedirectUrl" class="form-control form-control-premium" placeholder="@L.Get("admin.banners.create.redirectPlaceholder")" />
                    <span asp-validation-for="RedirectUrl" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="row mb-4">
                    <!-- Display Order -->
                    <div class="col-md-6">
                        <label asp-for="DisplayOrder" class="form-label text-light font-weight-bold"></label>
                        <input asp-for="DisplayOrder" type="number" class="form-control form-control-premium" />
                        <span asp-validation-for="DisplayOrder" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Is Active Switch -->
                    <div class="col-md-6 d-flex align-items-end">
                        <div class="form-check form-switch mb-2">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" id="IsActiveSwitch" />
                            <label class="form-check-label text-light ms-2" for="IsActiveSwitch">@L.Get("admin.banners.create.isActiveLabel")</label>
                        </div>
                    </div>
                </div>

                <!-- Actions -->
                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top" style="border-color: rgba(255,255,255,0.05) !important;">
                    <a asp-area="Admin" asp-controller="Banners" asp-action="Index" class="btn btn-premium btn-premium-secondary">
                        @L.Get("admin.banners.create.cancel")
                    </a>
                    <button type="submit" class="btn btn-premium btn-premium-primary">
                        <i class="fa-solid fa-check me-1"></i> @L.Get("admin.banners.create.submit")
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
