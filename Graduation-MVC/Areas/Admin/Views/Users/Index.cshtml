@model Graduation_MVC.Areas.Admin.ViewModels.Users.AdminUsersPageViewModel
@{
    ViewData["Title"] = "Customers Management";
}

<div class="row align-items-center mb-4">
    <div class="col-md-7">
        <h1 class="display-font text-light mb-1">Customers Management</h1>
        <p class="text-muted mb-0">Search, filter, and manage customer accounts.</p>
    </div>

    <div class="col-md-5 text-md-end mt-3 mt-md-0">
        <div class="glass-card px-3 py-2 d-inline-flex align-items-center gap-3">
            <span class="text-muted small">Total Customers:</span>
            <span class="badge fs-6 font-monospace"
                  style="background-color: var(--accent-primary);">
                @Model.TotalCount
            </span>
        </div>
    </div>
</div>

<!-- FILTERS -->
<div class="glass-card p-4 mb-4">
    <form method="get" asp-area="Admin" asp-controller="Users" asp-action="Index">

        <div class="row g-3 align-items-end">

            <div class="col-md-6">
                <label class="form-label text-muted small">Search</label>
                <input name="Search"
                       value="@Model.Filter?.Search"
                       class="form-control form-control-premium"
                       placeholder="Name or email" />
            </div>

            <div class="col-md-3">
                <label class="form-label text-muted small">Status</label>
                <select name="Status" class="form-select form-select-premium">
                    <option value="">All</option>
                    <option value="Active" selected="@(Model.Filter?.Status == "Active")">Active</option>
                    <option value="Suspended" selected="@(Model.Filter?.Status == "Suspended")">Suspended</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label text-muted small">Email Confirmed</label>
                <select name="EmailConfirmed" class="form-select form-select-premium">
                    <option value="">All</option>
                    <option value="Confirmed" selected="@(Model.Filter?.EmailConfirmed == "Confirmed")">Confirmed</option>
                    <option value="NotConfirmed" selected="@(Model.Filter?.EmailConfirmed == "NotConfirmed")">Not Confirmed</option>
                </select>
            </div>

        </div>

        <div class="d-flex justify-content-end gap-2 mt-3 pt-3 border-top">
            <a asp-area="Admin" asp-controller="Users" asp-action="Index"
               class="btn btn-premium btn-premium-secondary">
                Reset
            </a>

            <button type="submit"
                    class="btn btn-premium btn-premium-primary">
                Apply Filters
            </button>
        </div>

    </form>
</div>

<!-- TABLE -->
<div class="glass-card p-4">
    <div class="table-responsive">

        <table class="table table-premium mb-0">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Status</th>
                    <th>Email Confirmed</th>
                    <th>Phone</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var u in Model.Users)
                {
                    <tr>

                        <!-- NAME ONLY -->
                        <td>
                            <div class="fw-semibold text-light">@u.FullName</div>
                        </td>

                        <!-- EMAIL ONLY -->
                        <td class="text-muted small">
                            @u.Email
                        </td>

                        <!-- STATUS -->
                        <td>
                            @if (u.IsActive)
                            {
                                <span class="badge-status badge-status-active">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge-status badge-status-hidden">
                                    Suspended
                                </span>
                            }
                        </td>

                        <!-- EMAIL CONFIRMED -->
                        <td>
                            @if (u.EmailConfirmed)
                            {
                                <span class="badge-status badge-status-active">
                                    Confirmed
                                </span>
                            }
                            else
                            {
                                <span class="badge-status badge-status-pending">
                                    Not Confirmed
                                </span>
                            }
                        </td>

                        <!-- PHONE -->
                        <td class="text-muted small">
                            @u.PhoneNumber
                        </td>

                        <!-- ACTIONS -->
                        <td class="text-end">
                            <div class="actions-icons">

                                <a asp-action="Details"
                                   asp-route-id="@u.Id"
                                   class="btn btn-sm btn-premium btn-premium-secondary me-1 action-btn">
                                    <span class="action-label d-none d-sm-inline">Details</span>
                                    <i class="fa-solid fa-eye action-icon"></i>
                                </a>

                                @if (u.IsActive)
                                {
                                    <form asp-action="Suspend"
                                          asp-route-id="@u.Id"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return showSuspendConfirm(this);">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm me-1 action-btn"
                                                style="background: var(--color-warning); color:#fff; border:0;">
                                            <span class="action-label d-none d-sm-inline">Suspend</span>
                                            <i class="fa-solid fa-ban action-icon"></i>
                                        </button>

                                    </form>
                                }
                                else
                                {
                                    <form asp-action="Activate"
                                          asp-route-id="@u.Id"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-premium btn-premium-primary me-1 action-btn">
                                            <span class="action-label d-none d-sm-inline">Activate</span>
                                            <i class="fa-solid fa-circle-check action-icon"></i>
                                        </button>

                                    </form>
                                }

                                <form asp-action="Delete"
                                      asp-route-id="@u.Id"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return showDeleteConfirm(this);">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-sm action-btn"
                                            style="background:var(--color-danger); color:#fff; border:0;">
                                        <span class="action-label d-none d-sm-inline">Delete</span>
                                        <i class="fa-solid fa-trash action-icon"></i>
                                    </button>

                                </form>

                            </div>

                        </td>

                    </tr>
                }
            </tbody>
        </table>

    </div>

    <!-- PAGINATION -->
    <div class="d-flex justify-content-between align-items-center mt-4">
        <div class="text-muted small">
            Page @Model.Page of @Model.TotalPages
        </div>

        <div class="btn-group">
            @if (Model.Page > 1)
            {
                <a class="btn btn-premium btn-premium-secondary btn-sm"
                   asp-route-page="@(Model.Page - 1)">
                    Previous
                </a>
            }

            @if (Model.Page < Model.TotalPages)
            {
                <a class="btn btn-premium btn-premium-secondary btn-sm"
                   asp-route-page="@(Model.Page + 1)">
                    Next
                </a>
            }
        </div>
    </div>
</div>

<style>
    .actions-icons {
        display: inline-flex;
        align-items: center;
        justify-content: flex-end;
        gap: .25rem;
        flex-wrap: wrap;
    }

    .actions-icons .action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .35rem;
        padding: .28rem .6rem;
        font-size: .95rem;
        line-height: 1;
        min-height: 34px;
        border-radius: .35rem;
    }

    .actions-icons .action-btn.me-1 {
        margin-right: 0 !important;
    }

    .actions-icons .action-icon {
        font-size: 1rem;
        width: 1em;
        line-height: 1;
        display: inline-block;
        text-align: center;
    }

    @@media (max-width: 575.98px) {
        .actions-icons {
            gap: .2rem;
        }

        .actions-icons a,
        .actions-icons form {
            margin: 0 !important;
        }

        .actions-icons .action-btn {
            padding: 0;
            min-width: 38px;
            width: 38px;
            flex: 0 0 38px;
            margin: 0 !important;
        }

        .actions-icons .action-label {
            display: none !important;
        }

        .actions-icons .action-icon {
            margin: 0;
        }
    }
</style>

<!-- SWEET ALERT -->
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>

        function showSuspendConfirm(form) {
        Swal.fire({
        title: 'Suspend User?',
        text: "This user will lose access to the system.",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'Yes, Suspend',
        cancelButtonText: 'Cancel',
        reverseButtons: true,
        customClass: { popup: 'swal2-rounded' }
        }).then((result) => {
        if (result.isConfirmed) {
        form.submit();
        }
        });

        return false;
        }

        function showDeleteConfirm(form) {
        Swal.fire({
        title: 'Delete User?',
        text: "This action cannot be undone.",
        icon: 'error',
        showCancelButton: true,
        confirmButtonText: 'Yes, Delete',
        cancelButtonText: 'Cancel',
        reverseButtons: true,
        confirmButtonColor: '#d33',
        customClass: { popup: 'swal2-rounded' }
        }).then((result) => {
        if (result.isConfirmed) {
        form.submit();
        }
        });

        return false;
        }

    </script>
}