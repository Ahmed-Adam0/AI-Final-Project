@model Graduation_MVC.Areas.Admin.ViewModels.Categories.AdminSubCategoryFormViewModel
@using Graduation_Application.IServices.Admin
@inject ILocalizationService L

@{
    ViewData["Title"] = "Edit Subcategory";
}

<div class="mb-3">
    <a asp-area="Admin" asp-controller="Categories" asp-action="SubCategories" asp-route-categoryId="@Model.CategoryId" class="btn btn-premium btn-premium-secondary small py-1 px-3">
        <i class="fa-solid fa-arrow-left me-1"></i> Back to Subcategories
    </a>
</div>

<div class="row mb-4">
    <div class="col-md-6">
        <h1 class="display-font text-light mb-1">Edit Subcategory</h1>
        <p class="text-muted mb-0">Modify sub-classification details under Category "@Model.CategoryNameEn"</p>
    </div>
</div>

<div class="row">
    <div class="col-md-8 col-lg-6">
        <div class="glass-card p-4">
            <form asp-area="Admin" asp-controller="Categories" asp-action="EditSubCategory" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CategoryId" />
                <input type="hidden" asp-for="CategoryNameEn" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4 bg-danger bg-opacity-10 border-danger text-danger small" style="border-radius: 8px;"></div>

                <div class="mb-3">
                    <label asp-for="NameEn" class="form-label text-light small"></label>
                    <input asp-for="NameEn" class="form-control form-control-premium" />
                    <span asp-validation-for="NameEn" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="NameAr" class="form-label text-light small"></label>
                    <input asp-for="NameAr" class="form-control form-control-premium" dir="rtl" />
                    <span asp-validation-for="NameAr" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2 justify-content-end">
                    <a asp-area="Admin" asp-controller="Categories" asp-action="SubCategories" asp-route-categoryId="@Model.CategoryId" class="btn btn-premium btn-premium-secondary">
                        Cancel
                    </a>
                    <button type="submit" class="btn btn-premium btn-premium-primary">
                        <i class="fa-solid fa-check me-1"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
