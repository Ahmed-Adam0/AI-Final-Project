@model IEnumerable<Graduation_Application.DTOs.CategoryDTO.SubCategoryDto>
@using Graduation_Application.IServices.Admin
@inject ILocalizationService L
@{
    var category = (Graduation_Application.DTOs.CategoryDTO.CategoryDto)ViewBag.Category;
    var isArabic = L.GetCurrentCulture() == "ar";
    var categoryName = isArabic ? category.NameAr : category.NameEn;
    ViewData["Title"] = string.Format(L.Get("admin.categories.subcategoriesOf"), categoryName);
}

<div class="mb-3">
    <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="btn btn-premium btn-premium-secondary small py-1 px-3">
        <i class="fa-solid fa-arrow-left me-1"></i> @L.Get("admin.categories.backToCategories")
    </a>
</div>

<div class="row align-items-center mb-4">
    <div class="col-md-6">
        <h1 class="display-font text-light mb-1">@string.Format(L.Get("admin.categories.subcategoriesOf"), $"{category.NameEn} ({category.NameAr})")</h1>
        <p class="text-muted mb-0">@L.Get("admin.categories.manageSubcategories")</p>
    </div>
    <div class="col-md-6 text-md-end mt-3 mt-md-0 d-flex justify-content-md-end align-items-center gap-3">
        <div class="glass-card px-3 py-2 d-inline-flex align-items-center gap-3">
            <span class="text-muted small">@L.Get("auth.dashboard.Total"):</span>
            <span class="badge fs-6 font-monospace" style="background-color: var(--accent-primary);">@Model.Count()</span>
        </div>
        <a asp-area="Admin" asp-controller="Categories" asp-action="CreateSubCategory" asp-route-categoryId="@category.Id" class="btn btn-premium btn-premium-primary">
            <i class="fa-solid fa-plus me-1"></i> @L.Get("admin.categories.addSubcategory")
        </a>
    </div>
</div>

<!-- Subcategories Table -->
<div class="glass-card p-4">
    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div class="text-muted mb-3"><i class="fa-solid fa-folder-open fa-3x"></i></div>
            <h5 class="text-light">@L.Get("admin.categories.noSubcategories")</h5>
            <p class="text-muted small">@string.Format(L.Get("admin.categories.clickToAddSubcategory"), categoryName)</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-premium">
                <thead>
                    <tr>
                        <th>@L.Get("admin.categories.table.nameEn")</th>
                        <th>@L.Get("admin.categories.table.nameAr")</th>
                        <th class="text-end" style="width: 300px;">@L.Get("admin.categories.table.actions")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <!-- English Name -->
                            <td class="text-light font-weight-bold align-middle">@item.NameEn</td>
                            <!-- Arabic Name -->
                            <td class="text-light align-middle">@item.NameAr</td>
                            <!-- Actions -->
                            <td class="text-end align-middle">
                                <div class="d-flex justify-content-end gap-2">
                                    <a asp-area="Admin" asp-controller="Categories" asp-action="ProductTypes" asp-route-subCategoryId="@item.Id" class="btn btn-sm btn-premium btn-premium-secondary py-1 px-2" title="@L.Get("admin.categories.productTypes")">
                                        <i class="fa-solid fa-tags me-1"></i> @L.Get("admin.categories.productTypes")
                                    </a>
                                    <a asp-area="Admin" asp-controller="Categories" asp-action="EditSubCategory" asp-route-id="@item.Id" class="btn btn-sm btn-premium btn-premium-secondary py-1 px-2" title="Edit">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>
                                    
                                    <form asp-area="Admin" asp-controller="Categories" asp-action="DeleteSubCategory" asp-route-id="@item.Id" asp-route-categoryId="@category.Id" method="post" onsubmit="return confirm('@L.Get("admin.categories.confirmDeleteSubcategory")');" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-premium btn-premium-danger py-1 px-2" title="Delete">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
