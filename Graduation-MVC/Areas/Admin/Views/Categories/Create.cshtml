@model AdminCategoryFormViewModel
@using Graduation_Application.IServices.Admin
@inject Graduation_Application.IServices.Admin.ILocalizationService L
@{
    ViewData["Title"] = L.Get("admin.categories.create.title");
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h1 class="display-font text-light mb-1">@L.Get("admin.categories.create.title")</h1>
        <p class="text-muted mb-0">@L.Get("admin.categories.create.heading")</p>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="btn btn-premium btn-premium-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i> @L.Get("admin.categories.backToList")
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8 mx-auto">
        <div class="glass-card p-4">
            <form asp-area="Admin" asp-controller="Categories" asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- English Name -->
                <div class="mb-4">
                    <label asp-for="NameEn" class="form-label text-light font-weight-bold">@L.Get("admin.categories.create.nameEnLabel")</label>
                    <input asp-for="NameEn" class="form-control form-control-premium" placeholder="@L.Get("admin.categories.create.nameEnPlaceholder")" />
                    <span asp-validation-for="NameEn" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Arabic Name -->
                <div class="mb-4">
                    <label asp-for="NameAr" class="form-label text-light font-weight-bold">@L.Get("admin.categories.create.nameArLabel")</label>
                    <input asp-for="NameAr" class="form-control form-control-premium text-end" placeholder="@L.Get("admin.categories.create.nameArPlaceholder")" dir="rtl" />
                    <span asp-validation-for="NameAr" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Image File -->
                <div class="mb-4">
                    <label asp-for="ImageFile" class="form-label text-light font-weight-bold">@L.Get("admin.categories.create.imageLabel")</label>
                    <input asp-for="ImageFile" type="file" class="form-control form-control-premium" accept=".jpg,.jpeg,.png" />
                    <span asp-validation-for="ImageFile" class="text-danger small mt-1 d-block"></span>
                    <div class="form-text text-muted small mt-1">@L.Get("admin.categories.create.imageHint")</div>
                </div>

                <!-- Actions -->
                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top" style="border-color: rgba(255,255,255,0.05) !important;">
                    <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="btn btn-premium btn-premium-secondary">
                        @L.Get("admin.categories.create.cancel")
                    </a>
                    <button type="submit" class="btn btn-premium btn-premium-primary">
                        <i class="fa-solid fa-check me-1"></i> @L.Get("admin.categories.create.submit")
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
