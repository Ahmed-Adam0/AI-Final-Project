@model AdminCategoryFormViewModel
@using Graduation_Application.IServices.Admin
@inject Graduation_Application.IServices.Admin.ILocalizationService L
@{
    ViewData["Title"] = L.Get("admin.categories.edit.title");
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h1 class="display-font text-light mb-1">@L.Get("admin.categories.edit.title")</h1>
        <p class="text-muted mb-0">@L.Get("admin.categories.edit.heading")</p>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="btn btn-premium btn-premium-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i> @L.Get("admin.categories.backToList")
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Edit Form -->
    <div class="col-lg-8">
        <div class="glass-card p-4">
            <form asp-area="Admin" asp-controller="Categories" asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ImageUrl" />
                
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- English Name -->
                <div class="mb-4">
                    <label asp-for="NameEn" class="form-label text-light font-weight-bold"></label>
                    <input asp-for="NameEn" class="form-control form-control-premium" placeholder="@L.Get("admin.categories.create.nameEnPlaceholder")" />
                    <span asp-validation-for="NameEn" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Arabic Name -->
                <div class="mb-4">
                    <label asp-for="NameAr" class="form-label text-light font-weight-bold"></label>
                    <input asp-for="NameAr" class="form-control form-control-premium text-end" placeholder="@L.Get("admin.categories.create.nameArPlaceholder")" dir="rtl" />
                    <span asp-validation-for="NameAr" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Image File -->
                <div class="mb-4">
                    <label asp-for="ImageFile" class="form-label text-light font-weight-bold"></label>
                    <input asp-for="ImageFile" type="file" class="form-control form-control-premium" accept=".jpg,.jpeg,.png" />
                    <span asp-validation-for="ImageFile" class="text-danger small mt-1 d-block"></span>
                    <div class="form-text text-muted small mt-1">@L.Get("admin.categories.edit.imageHint")</div>
                </div>

                <!-- Actions -->
                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top" style="border-color: rgba(255,255,255,0.05) !important;">
                    <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="btn btn-premium btn-premium-secondary">
                        @L.Get("admin.categories.edit.cancel")
                    </a>
                    <button type="submit" class="btn btn-premium btn-premium-primary">
                        <i class="fa-solid fa-check me-1"></i> @L.Get("admin.categories.edit.submit")
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Image Preview Column -->
    <div class="col-lg-4">
        <div class="glass-card p-4 text-center">
            <h5 class="text-light mb-3">@L.Get("admin.categories.edit.currentImage")</h5>
            <div class="rounded overflow-hidden bg-secondary border mx-auto mb-3" style="width: 200px; height: 200px; border-color: var(--border-color) !important;">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img id="category-preview" src="@Model.ImageUrl" alt="Current Image" style="width: 100%; height: 100%; object-fit: cover;" />
                }
                else
                {
                    <div class="d-flex align-items-center justify-content-center h-100 text-muted bg-dark">
                        <i class="fa-solid fa-image fa-3x"></i>
                    </div>
                }
            </div>
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <span class="text-muted small word-break-all">@Model.ImageUrl</span>
            }
            else
            {
                <span class="text-muted small">@L.Get("admin.categories.edit.noImage")</span>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Simple client-side preview for the uploaded file
        document.getElementById('ImageFile').addEventListener('change', function (e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (event) {
                    const img = document.getElementById('category-preview');
                    if (img) {
                        img.src = event.target.result;
                    }
                };
                reader.readAsDataURL(file);
            }
        });
    </script>
}
