@model Graduation_MVC.Areas.Admin.ViewModels.Orders.AdminOrdersPageViewModel
@{
    ViewData["Title"] = "Orders";
}

<div class="row align-items-center mb-4">
    <div class="col-md-7">
        <h1 class="display-font text-light mb-1">Orders Management</h1>
        <p class="text-muted mb-0">Search, filter, sort, and review marketplace orders.</p>
    </div>
    <div class="col-md-5 text-md-end mt-3 mt-md-0">
        <div class="glass-card px-3 py-2 d-inline-flex align-items-center gap-3">
            <span class="text-muted small">Total Orders:</span>
            <span class="badge bg-indigo fs-6 font-monospace" style="background-color: var(--accent-primary);">@Model.Paging.TotalCount</span>
        </div>
    </div>
</div>

<div class="glass-card p-4 mb-4">
    <form method="get" asp-area="Admin" asp-controller="Orders" asp-action="Index">
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label text-muted small">Search</label>
                <input asp-for="Filter.Search" class="form-control form-control-premium" placeholder="Order number or customer" />
            </div>
            <div class="col-md-2">
                <label class="form-label text-muted small">Status</label>
                <select asp-for="Filter.Status" class="form-select form-select-premium">
                    @foreach (var item in Model.StatusOptions)
                    {
                        <option value="@item.Value">@item.Label</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label text-muted small">Vendor</label>
                <select asp-for="Filter.VendorId" class="form-select form-select-premium">
                    @foreach (var vendor in Model.Vendors)
                    {
                        <option value="@vendor.Value">@vendor.Label</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label text-muted small">From</label>
                <input asp-for="Filter.FromDate" type="date" class="form-control form-control-premium" />
            </div>
            <div class="col-md-2">
                <label class="form-label text-muted small">To</label>
                <input asp-for="Filter.ToDate" type="date" class="form-control form-control-premium" />
            </div>
        </div>
        <div class="d-flex justify-content-end gap-2 mt-3 pt-3 border-top">
            <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="btn btn-premium btn-premium-secondary">Reset</a>
            <button type="submit" class="btn btn-premium btn-premium-primary">Apply Filters</button>
        </div>
    </form>
</div>

<div class="glass-card p-4">
    <div class="table-responsive">
        <table class="table table-premium mb-0">
            <thead>
                <tr>
                    <th>Order</th>
                    <th>Customer</th>
                    <th>Vendor</th>
                    <th>Status</th>
                    <th>Payment</th>
                    <th>Date</th>
                    <th class="text-end">Total</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.Orders)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold text-light">@order.OrderNumber</div>
                            <div class="text-muted small">#@order.Id</div>
                        </td>
                        <td>@order.CustomerName</td>
                        <td>@order.VendorName</td>
                        <td>
                            @{
                                var StatusClass = order.Status switch
                                {
                                    "Confirmed" => "badge-status-active",
                                    "Delivered" => "badge-status-active",
                                    "Cancelled" => "badge-status-inactive",
                                    "Rejected" => "badge-status-hidden",
                                    _ => "badge-status-pending"
                                };

                                var statusIcon = order.Status switch
                                {
                                    "Confirmed" => "fa-solid fa-circle-check",
                                    "Delivered" => "fa-solid fa-truck-fast",
                                    "Cancelled" => "fa-solid fa-circle-xmark",
                                    "Rejected" => "fa-solid fa-ban",
                                    _ => "fa-solid fa-hourglass-half"
                                };
                            }
                            <span class="badge-status @StatusClass">
                                <i class="@statusIcon me-1"></i> @order.Status
                            </span>
                        </td>
                        <td>
                            @{
                                var paymentStatusClass = order.PaymentStatus switch
                                {
                                    "Paid" => "badge-status-active",
                                    "Failed" => "badge-status-hidden",
                                    _ => "badge-status-pending"
                                };

                                var paymentStatusIcon = order.PaymentStatus switch
                                {
                                    "Paid" => "fa-solid fa-circle-check",
                                    "Failed" => "fa-solid fa-circle-xmark",
                                    _ => "fa-solid fa-hourglass-half"
                                };
                            }
                            <span class="badge-status @paymentStatusClass">
                                <i class="@paymentStatusIcon me-1"></i> @order.PaymentStatus
                            </span>
                        </td>
                        <td class="text-muted small">@order.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="text-end fw-semibold">@order.TotalPrice.ToString("C2")</td>
                        <td class="text-end">
                            <a asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-premium btn-premium-secondary">View Details</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-4">
        <div class="text-muted small">Page @Model.Paging.Page of @Model.Paging.TotalPages</div>
        <div class="btn-group">
            @if (Model.Paging.HasPrevious)
            {
                <a class="btn btn-premium btn-premium-secondary btn-sm" asp-route-page="@(Model.Paging.Page - 1)">Previous</a>
            }
            @if (Model.Paging.HasNext)
            {
                <a class="btn btn-premium btn-premium-secondary btn-sm" asp-route-page="@(Model.Paging.Page + 1)">Next</a>
            }
        </div>
    </div>
</div>
