@model Graduation_MVC.Areas.Admin.ViewModels.Profile.AdminEditProfileViewModel
@{
    ViewData["Title"] = "Edit Profile";
    // Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h1 class="display-font text-light mb-1">Edit Profile</h1>
        <p class="text-muted mb-0">Update your account information and preferences.</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8 offset-lg-2">
        <div class="glass-card p-4">
            <form asp-area="Admin" asp-controller="Profile" asp-action="Edit" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

                <div class="mb-3">
                    <label for="FullName" class="form-label text-light">Full Name</label>
                    <input type="text" 
                           class="form-control form-control-premium @(Html.ViewData.ModelState.ContainsKey("FullName") && !Html.ViewData.ModelState["FullName"].Errors.Any() ? "" : Html.ViewData.ModelState.ContainsKey("FullName") ? "is-invalid" : "")" 
                           id="FullName" 
                           asp-for="FullName" 
                           placeholder="Enter your full name"
                           required>
                    <span asp-validation-for="FullName" class="text-danger small d-block mt-1"></span>
                </div>

                <div class="mb-3">
                    <label for="PhoneNumber" class="form-label text-light">Phone Number</label>
                    <input type="tel" 
                           class="form-control form-control-premium @(Html.ViewData.ModelState.ContainsKey("PhoneNumber") && !Html.ViewData.ModelState["PhoneNumber"].Errors.Any() ? "" : Html.ViewData.ModelState.ContainsKey("PhoneNumber") ? "is-invalid" : "")" 
                           id="PhoneNumber" 
                           asp-for="PhoneNumber" 
                           placeholder="Enter your phone number">
                    <span asp-validation-for="PhoneNumber" class="text-danger small d-block mt-1"></span>
                </div>

                <div class="mb-3">
                    <label for="PreferredLanguage" class="form-label text-light">Preferred Language</label>
                    <select class="form-select form-control-premium @(Html.ViewData.ModelState.ContainsKey("PreferredLanguage") && !Html.ViewData.ModelState["PreferredLanguage"].Errors.Any() ? "" : Html.ViewData.ModelState.ContainsKey("PreferredLanguage") ? "is-invalid" : "")" 
                            id="PreferredLanguage" 
                            asp-for="PreferredLanguage" 
                            required>
                        <option value="">-- Select Language --</option>
                        <option value="ar" selected="@(Model?.PreferredLanguage == "ar")">العربية</option>
                        <option value="en" selected="@(Model?.PreferredLanguage == "en")">English</option>
                    </select>
                    <span asp-validation-for="PreferredLanguage" class="text-danger small d-block mt-1"></span>
                </div>

                <div class="mb-4">
                    <label for="ProfileImage" class="form-label text-light">Profile Image</label>
                    <div class="row g-3 align-items-start">
                        <div class="col-md-6">
                            <input type="file" 
                                   class="form-control form-control-premium" 
                                   id="ProfileImage" 
                                   asp-for="ProfileImage" 
                                   accept="image/*">
                            <small class="text-muted d-block mt-1">Supported formats: JPG, PNG, GIF (Max 5MB)</small>
                            <span asp-validation-for="ProfileImage" class="text-danger small d-block mt-1"></span>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.CurrentProfileImage))
                        {
                            <div class="col-md-6">
                                <div class="text-center">
                                    <p class="text-muted small mb-2">Current Image</p>
                                    <img src="@Model.CurrentProfileImage" alt="Current Profile" class="rounded" style="max-width: 150px; max-height: 150px; object-fit: cover; border: 2px solid var(--accent-primary);">
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="d-flex gap-2 justify-content-between">
                    <a asp-area="Admin" asp-controller="Profile" asp-action="Index" class="btn btn-premium btn-premium-secondary">
                        <i class="fa-solid fa-arrow-left me-2"></i>Cancel
                    </a>
                    <button type="submit" class="btn btn-premium btn-premium-primary">
                        <i class="fa-solid fa-check me-2"></i>Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
