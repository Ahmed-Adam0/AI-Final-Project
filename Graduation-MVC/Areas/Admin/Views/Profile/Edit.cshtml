@model Graduation_MVC.Areas.Admin.ViewModels.Profile.AdminEditProfileViewModel
@using Graduation_Application.IServices.Admin
@inject ILocalizationService LocalizationService
@{
    var isArabic = LocalizationService.GetCurrentCulture() == "ar";
    ViewData["Title"] = LocalizationService.Get("auth.profile.editProfile");
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h1 class="display-font text-light mb-1">@LocalizationService.Get("auth.profile.editProfile")</h1>
        <p class="text-muted mb-0">@LocalizationService.Get("auth.profile.editSubtitle")</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-8 offset-lg-2">
        <div class="glass-card p-4">
            <form asp-area="Admin" asp-controller="Profile" asp-action="Edit" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>
                 <div class="mb-4">
                    <label for="ProfileImage" class="form-label text-light">@LocalizationService.Get("auth.profile.profileImage")</label>

                    <div class="text-center mb-4">
                        <div class="profile-image-wrapper" onclick="document.getElementById('profileImageInput').click()" style="cursor:pointer; display:inline-block; position:relative;">

                            @if (!string.IsNullOrEmpty(Model.CurrentProfileImage))
                            {
                                <img id="profilePreview" src="@Model.CurrentProfileImage" 
                                     style="width:120px; height:120px; border-radius:50%; object-fit:cover; border:3px solid var(--accent-primary);" />
                            }
                            else
                            {
                                <div id="profilePreview" style="width:120px; height:120px; border-radius:50%; background:#e9ecef; display:flex; align-items:center; justify-content:center; border:3px solid var(--border-color);">
                                    <i class="fa-solid fa-user" style="font-size:2.5rem; color:#adb5bd;"></i>
                                </div>
                            }

                            <div style="position:absolute; bottom:4px; right:4px; background:var(--accent-primary); border-radius:50%; width:32px; height:32px; display:flex; align-items:center; justify-content:center;">
                                <i class="fa-solid fa-camera" style="color:#fff; font-size:0.85rem;"></i>
                            </div>
                        </div>
                        <input type="file" id="profileImageInput" name="ProfileImage" accept="image/*" style="display:none">
                        <p class="text-muted small mt-2">@LocalizationService.Get("auth.profile.changePhotoClick")</p>
                    </div>
                </div>
                <div class="mb-3">
                    <label for="FullName" class="form-label text-light">@LocalizationService.Get("auth.profile.fullName")</label>
                    <input type="text" 
                           class="form-control form-control-premium @(Html.ViewData.ModelState.ContainsKey("FullName") && !Html.ViewData.ModelState["FullName"].Errors.Any() ? "" : Html.ViewData.ModelState.ContainsKey("FullName") ? "is-invalid" : "")" 
                           id="FullName" 
                           asp-for="FullName" 
                           placeholder="@LocalizationService.Get("auth.profile.fullNamePlace")"
                           required>
                    <span asp-validation-for="FullName" class="text-danger small d-block mt-1"></span>
                </div>

                <div class="mb-3">
                    <label for="PhoneNumber" class="form-label text-light">@LocalizationService.Get("auth.profile.phoneNumber")</label>
                    <input type="tel" 
                           class="form-control form-control-premium @(Html.ViewData.ModelState.ContainsKey("PhoneNumber") && !Html.ViewData.ModelState["PhoneNumber"].Errors.Any() ? "" : Html.ViewData.ModelState.ContainsKey("PhoneNumber") ? "is-invalid" : "")" 
                           id="PhoneNumber" 
                           asp-for="PhoneNumber" 
                           placeholder="@LocalizationService.Get("auth.profile.phonePlace")">
                    <span asp-validation-for="PhoneNumber" class="text-danger small d-block mt-1"></span>
                </div>

                <div class="mb-3">
                    <label for="PreferredLanguage" class="form-label text-light">@LocalizationService.Get("auth.profile.preferredLanguage")</label>
                    <select class="form-select form-control-premium @(Html.ViewData.ModelState.ContainsKey("PreferredLanguage") && !Html.ViewData.ModelState["PreferredLanguage"].Errors.Any() ? "" : Html.ViewData.ModelState.ContainsKey("PreferredLanguage") ? "is-invalid" : "")" 
                            id="PreferredLanguage" 
                            asp-for="PreferredLanguage" 
                            required>
                        <option value="">@LocalizationService.Get("auth.profile.selectLanguage")</option>
                        <option value="ar" selected="@(Model?.PreferredLanguage == "ar")">@LocalizationService.Get("auth.layout.arabic")</option>
                        <option value="en" selected="@(Model?.PreferredLanguage == "en")">@LocalizationService.Get("auth.layout.english")</option>
                    </select>
                    <span asp-validation-for="PreferredLanguage" class="text-danger small d-block mt-1"></span>
                </div>

                <div class="d-flex flex-column flex-sm-row gap-2 justify-content-between">

                    <a asp-area="Admin"
                       asp-controller="Profile"
                       asp-action="Index"
                       class="btn btn-premium btn-premium-secondary w-100 w-sm-auto">
                        <i class="fa-solid @(isArabic ? "fa-arrow-right" : "fa-arrow-left") me-2"></i>
                        @LocalizationService.Get("auth.profile.cancel")
                    </a>

                    <button type="submit"
                            class="btn btn-premium btn-premium-primary w-100 w-sm-auto">
                        <i class="fa-solid fa-check me-2"></i>
                        @LocalizationService.Get("auth.profile.saveChanges")
                    </button>

                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('profileImageInput').addEventListener('change', function(e) {
            var file = e.target.files[0];
            if (!file) return;
            var reader = new FileReader();
            reader.onload = function(ev) {
                var preview = document.getElementById('profilePreview');
                if (preview.tagName === 'IMG') {
                    preview.src = ev.target.result;
                } else {
                    var img = document.createElement('img');
                    img.id = 'profilePreview';
                    img.src = ev.target.result;
                    img.style = 'width:120px; height:120px; border-radius:50%; object-fit:cover; border:3px solid var(--accent-primary);';
                    preview.parentNode.replaceChild(img, preview);
                }
            };
            reader.readAsDataURL(file);
        });
    </script>
}
