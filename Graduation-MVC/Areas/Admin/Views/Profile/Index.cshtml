@model Graduation_MVC.Areas.Admin.ViewModels.Profile.AdminProfileViewModel
@{
    ViewData["Title"] = "My Profile";
    // Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h1 class="display-font text-light mb-1">My Profile</h1>
        <p class="text-muted mb-0">View and manage your admin account information.</p>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <div class="d-inline-flex gap-2">
            <a asp-area="Admin" asp-controller="Profile" asp-action="Edit" class="btn btn-premium btn-premium-primary">
                <i class="fa-solid fa-user-gear me-2"></i>Edit Profile
            </a>
            <a asp-area="Admin" asp-controller="Profile" asp-action="ChangePassword" class="btn btn-premium btn-premium-secondary">
                <i class="fa-solid fa-lock me-2"></i>Change Password
            </a>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="glass-card p-4">
            <div class="text-center mb-3">
                @if (!string.IsNullOrEmpty(Model.ProfileImage))
                {
                    <img src="@Model.ProfileImage" alt="Profile" class="rounded-circle" style="width: 120px; height: 120px; object-fit: cover; border: 3px solid var(--accent-primary);">
                }
                else
                {
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center bg-light" style="width: 120px; height: 120px; color: var(--accent-primary);">
                        <i class="fa-solid fa-circle-user fa-5x"></i>
                    </div>
                }
            </div>
            <h4 class="text-center text-light mb-1">@Model.FullName</h4>
            <p class="text-center text-muted small mb-0">Administrator</p>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="glass-card p-4">
            <h5 class="text-light mb-4">Account Information</h5>

            <div class="row mb-3">
                <div class="col-sm-4">
                    <label class="text-muted small text-uppercase fw-semibold" style="letter-spacing: 0.05em;">Full Name</label>
                </div>
                <div class="col-sm-8">
                    <p class="text-light">@Model.FullName</p>
                </div>
            </div>

            <hr class="border-secondary my-3">

            <div class="row mb-3">
                <div class="col-sm-4">
                    <label class="text-muted small text-uppercase fw-semibold" style="letter-spacing: 0.05em;">Email</label>
                </div>
                <div class="col-sm-8">
                    <p class="text-light">@Model.Email</p>
                </div>
            </div>

            <hr class="border-secondary my-3">

            <div class="row mb-3">
                <div class="col-sm-4">
                    <label class="text-muted small text-uppercase fw-semibold" style="letter-spacing: 0.05em;">Phone Number</label>
                </div>
                <div class="col-sm-8">
                    <p class="text-light">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "Not provided" : Model.PhoneNumber)</p>
                </div>
            </div>

            <hr class="border-secondary my-3">

            <div class="row mb-0">
                <div class="col-sm-4">
                    <label class="text-muted small text-uppercase fw-semibold" style="letter-spacing: 0.05em;">Language</label>
                </div>
                <div class="col-sm-8">
                    <p class="text-light">
                        @if (Model.PreferredLanguage == "ar")
                        {
                            <span><i class="fa-solid fa-globe me-2"></i>العربية</span>
                        }
                        else
                        {
                            <span><i class="fa-solid fa-globe me-2"></i>English</span>
                        }
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
