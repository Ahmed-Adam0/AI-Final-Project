@model Graduation_MVC.Areas.Admin.ViewModels.Profile.AdminProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h1 class="display-font text-light mb-1">My Profile</h1>
        <p class="text-muted mb-0">
            View and manage your admin account information.
        </p>
    </div>

    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <div class="d-inline-flex gap-2">
            <a asp-area="Admin"
               asp-controller="Profile"
               asp-action="Edit"
               class="btn btn-premium btn-premium-primary">
                <i class="fa-solid fa-user-gear me-2"></i>
                Edit Profile
            </a>

            <a asp-area="Admin"
               asp-controller="Profile"
               asp-action="ChangePassword"
               class="btn btn-premium btn-premium-secondary">
                <i class="fa-solid fa-lock me-2"></i>
                Change Password
            </a>
        </div>
    </div>
</div>

<div class="row g-4">

    <!-- Profile Card -->

    <div class="col-lg-4">

        <div class="glass-card p-4 h-100">

            <div class="text-center">

                @if (!string.IsNullOrWhiteSpace(Model.ProfileImage))
                {
                    <img src="@Model.ProfileImage"
                         alt="Profile"
                         class="rounded-circle mb-3"
                         style="width:130px;height:130px;object-fit:cover;border:3px solid var(--accent-primary);" />
                }
                else
                {
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                         style="width:130px;height:130px;background:rgba(255,255,255,.08)">
                        <i class="fa-solid fa-user fa-4x text-light"></i>
                    </div>
                }

                <h4 class="text-light mb-1">
                    @Model.FullName
                </h4>

                <p class="text-muted mb-3">
                    Administrator
                </p>

                <span class="badge bg-success px-3 py-2">
                    Active Account
                </span>

            </div>

            <hr class="border-secondary my-4" />

            <div>

                <div class="d-flex justify-content-between mb-3">
                    <span class="text-muted">
                        <i class="fa-solid fa-envelope me-2"></i>Email
                    </span>

                    <span>@Model.Email</span>
                </div>

                <div class="d-flex justify-content-between mb-3">
                    <span class="text-muted">
                        <i class="fa-solid fa-phone me-2"></i>Phone
                    </span>

                    <span>
                        @(string.IsNullOrWhiteSpace(Model.PhoneNumber)
                            ? "Not Provided"
                            : Model.PhoneNumber)
                    </span>
                </div>

                <div class="d-flex justify-content-between">
                    <span class="text-muted">
                        <i class="fa-solid fa-globe me-2"></i>Language
                    </span>

                    <span>
                        @(Model.PreferredLanguage == "ar"
                            ? "العربيه"
                            : "English")
                    </span>
                </div>

            </div>

        </div>

    </div>

    <!-- Details -->

    <div class="col-lg-8">

        <div class="glass-card p-4 mb-4">

            <h5 class="mb-4">
                <i class="fa-solid fa-user me-2"></i>
                Personal Information
            </h5>

            <div class="row g-3">

                <div class="col-md-6">
                    <div class="p-3 rounded border border-secondary-subtle">
                        <small class="text-muted d-block mb-2">
                            Full Name
                        </small>

                        <div class="fw-semibold">
                            @Model.FullName
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 rounded border border-secondary-subtle">
                        <small class="text-muted d-block mb-2">
                            Email Address
                        </small>

                        <div class="fw-semibold">
                            @Model.Email
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 rounded border border-secondary-subtle">
                        <small class="text-muted d-block mb-2">
                            Phone Number
                        </small>

                        <div class="fw-semibold">
                            @(string.IsNullOrWhiteSpace(Model.PhoneNumber)
                                ? "Not Provided"
                                : Model.PhoneNumber)
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 rounded border border-secondary-subtle">
                        <small class="text-muted d-block mb-2">
                            Preferred Language
                        </small>

                        <div class="fw-semibold">
                            @(Model.PreferredLanguage == "ar"
                                ? "العربيه"
                                : "English")
                        </div>
                    </div>
                </div>

            </div>

        </div>

        <div class="glass-card p-4">

            <h5 class="mb-4">
                <i class="fa-solid fa-shield-halved me-2"></i>
                Security Overview
            </h5>

            <div class="row g-3">

                <div class="col-md-6">
                    <div class="p-3 rounded border border-success-subtle">
                        <div class="text-success mb-2">
                            <i class="fa-solid fa-circle-check"></i>
                            Email Verification
                        </div>

                        <div>
                            Your email address is verified.
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 rounded border border-warning-subtle">
                        <div class="text-warning mb-2">
                            <i class="fa-solid fa-key"></i>
                            Password Security
                        </div>

                        <div>
                            Keep your password updated regularly.
                        </div>
                    </div>
                </div>

            </div>

        </div>

    </div>

</div>