@model Graduation_MVC.Areas.Admin.ViewModels.Profile.AdminChangePasswordViewModel
@using Graduation_Application.IServices.Admin
@inject ILocalizationService LocalizationService
@{
    var isArabic = LocalizationService.GetCurrentCulture() == "ar";
    ViewData["Title"] = LocalizationService.Get("auth.profile.changePassword");
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h1 class="display-font text-light mb-1">@LocalizationService.Get("auth.profile.changePassword")</h1>
        <p class="text-muted mb-0">@LocalizationService.Get("auth.profile.changePasswordSubtitle")</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-6 offset-lg-3">
        <div class="glass-card p-4">
            <form asp-area="Admin" asp-controller="Profile" asp-action="ChangePassword" method="post" asp-antiforgery="true">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

                <div class="mb-3">
                    <p class="text-muted small mb-2">@LocalizationService.Get("auth.profile.passwordMustContain")</p>
                    <ul class="list-unstyled small" id="passwordRequirements">
                        <li id="req-length">
                            <i class="fa-solid fa-circle-xmark text-danger me-1"></i>
                            <span>@LocalizationService.Get("auth.resetPassword.reqLength")</span>
                        </li>
                        <li id="req-upper">
                            <i class="fa-solid fa-circle-xmark text-danger me-1"></i>
                            <span>@LocalizationService.Get("auth.resetPassword.reqUpper")</span>
                        </li>
                        <li id="req-lower">
                            <i class="fa-solid fa-circle-xmark text-danger me-1"></i>
                            <span>@LocalizationService.Get("auth.resetPassword.reqLower")</span>
                        </li>
                        <li id="req-digit">
                            <i class="fa-solid fa-circle-xmark text-danger me-1"></i>
                            <span>@LocalizationService.Get("auth.resetPassword.reqDigit")</span>
                        </li>
                        <li id="req-special">
                            <i class="fa-solid fa-circle-xmark text-danger me-1"></i>
                            <span>@LocalizationService.Get("auth.resetPassword.reqSpecial")</span>
                        </li>
                    </ul>
                </div>

                <div class="mb-3">
                    <label for="CurrentPassword" class="form-label text-light">@LocalizationService.Get("auth.profile.currentPassword")</label>
                    <input type="password" 
                           class="form-control form-control-premium @(Html.ViewData.ModelState.ContainsKey("CurrentPassword") && !Html.ViewData.ModelState["CurrentPassword"].Errors.Any() ? "" : Html.ViewData.ModelState.ContainsKey("CurrentPassword") ? "is-invalid" : "")" 
                           id="CurrentPassword" 
                           asp-for="CurrentPassword" 
                           placeholder="@LocalizationService.Get("auth.profile.currentPasswordPlace")"
                           required>
                    <span asp-validation-for="CurrentPassword" class="text-danger small d-block mt-1"></span>
                </div>

                <div class="mb-3">
                    <label for="NewPassword" class="form-label text-light">@LocalizationService.Get("auth.profile.newPassword")</label>
                    <input type="password" 
                           class="form-control form-control-premium @(Html.ViewData.ModelState.ContainsKey("NewPassword") && !Html.ViewData.ModelState["NewPassword"].Errors.Any() ? "" : Html.ViewData.ModelState.ContainsKey("NewPassword") ? "is-invalid" : "")" 
                           id="NewPassword" 
                           asp-for="NewPassword" 
                           placeholder="@LocalizationService.Get("auth.profile.newPasswordPlace")"
                           required>
                    <span asp-validation-for="NewPassword" class="text-danger small d-block mt-1"></span>
                </div>

                <div class="mb-4">
                    <label for="ConfirmPassword" class="form-label text-light">@LocalizationService.Get("auth.resetPassword.confirmPassword")</label>
                    <input type="password" 
                           class="form-control form-control-premium @(Html.ViewData.ModelState.ContainsKey("ConfirmPassword") && !Html.ViewData.ModelState["ConfirmPassword"].Errors.Any() ? "" : Html.ViewData.ModelState.ContainsKey("ConfirmPassword") ? "is-invalid" : "")" 
                           id="ConfirmPassword" 
                           asp-for="ConfirmPassword" 
                           placeholder="@LocalizationService.Get("auth.profile.confirmPasswordPlace")"
                           required>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small d-block mt-1"></span>
                </div>

                <div class="d-flex flex-column flex-sm-row gap-2 justify-content-between profile-actions">

                    <a asp-area="Admin"
                       asp-controller="Profile"
                       asp-action="Index"
                       class="btn btn-premium btn-premium-secondary w-100 w-sm-auto">
                        <i class="fa-solid @(isArabic ? "fa-arrow-right" : "fa-arrow-left") me-2"></i>
                        @LocalizationService.Get("auth.profile.cancel")
                    </a>

                    <button type="submit"
                            class="btn btn-premium btn-premium-primary w-100 w-sm-auto">
                        <i class="fa-solid fa-check me-2"></i>
                        @LocalizationService.Get("auth.profile.changePassword")
                    </button>

                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('NewPassword').addEventListener('input', function () {
            var val = this.value;

            function check(id, condition) {
                var el = document.getElementById(id);
                var icon = el.querySelector('i');
                if (condition) {
                    icon.className = 'fa-solid fa-circle-check text-success me-1';
                } else {
                    icon.className = 'fa-solid fa-circle-xmark text-danger me-1';
                }
            }

            check('req-length', val.length >= 8);
            check('req-upper', /[A-Z]/.test(val));
            check('req-lower', /[a-z]/.test(val));
            check('req-digit', /[0-9]/.test(val));
            check('req-special', /[^A-Za-z0-9]/.test(val));
        });
    </script>
}
