@model Graduation_MVC.Areas.Admin.ViewModels.Reports.AdminReportsPageViewModel
@{
    ViewData["Title"] = "Reports";
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h1 class="display-font text-light mb-1">Reports Management</h1>
        <p class="text-muted mb-0">Generate, download, and export daily, weekly, and monthly reports.</p>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <form asp-area="Admin" asp-controller="Reports" asp-action="Generate" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" name="reportType" value="Monthly" class="btn btn-premium btn-premium-primary">
                <i class="fa-solid fa-file-circle-plus"></i> Generate Report
            </button>
        </form>
    </div>
</div>

<div class="glass-card p-4 mb-4">
    <form method="get" asp-area="Admin" asp-controller="Reports" asp-action="Index" class="row g-3 align-items-end">
        <div class="col-md-3"><input type="date" class="form-control form-control-premium" name="fromDate" /></div>
        <div class="col-md-3"><input type="date" class="form-control form-control-premium" name="toDate" /></div>
        <div class="col-md-3"><input type="text" class="form-control form-control-premium" name="vendorId" placeholder="Vendor" /></div>
        <div class="col-md-3"><input type="text" class="form-control form-control-premium" name="categoryId" placeholder="Category" /></div>
    </form>
</div>

<div class="glass-card p-4">
    <div class="table-responsive">
        <table class="table table-premium mb-0">
            <thead>
                <tr>
                    <th>Report</th>
                    <th>Type</th>
                    <th>Vendor</th>
                    <th>Date</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var report in Model.Reports)
                {
                    <tr>
                        <td>@report.Title</td>
                        <td><span class="badge bg-secondary">@report.Type</span></td>
                        <td>@report.VendorName</td>
                        <td>@report.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="text-end">
                            <a href="@report.DownloadUrl" class="btn btn-sm btn-premium btn-premium-secondary">Download</a>
                            <a href="@report.ExportPdfUrl" class="btn btn-sm btn-premium btn-premium-secondary">PDF</a>
                            <a href="@report.ExportExcelUrl" class="btn btn-sm btn-premium btn-premium-secondary">Excel</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
