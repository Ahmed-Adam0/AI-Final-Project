@model ErrorViewModel
@using Graduation_Application.IServices.Admin
@inject ILocalizationService LocalizationService
@{
    ViewData["Title"] = LocalizationService.Get("auth.layout.error");
}

<h1 class="text-danger">@LocalizationService.Get("auth.layout.error")</h1>
<h2 class="text-danger">@LocalizationService.Get("auth.layout.errorSubtitle")</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@LocalizationService.Get("auth.layout.requestId")</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>@LocalizationService.Get("auth.layout.developmentMode")</h3>
<p>
    @LocalizationService.Get("auth.layout.developmentModeDesc")
</p>
